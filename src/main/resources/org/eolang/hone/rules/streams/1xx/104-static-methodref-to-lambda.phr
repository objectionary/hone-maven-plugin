---
# yamllint disable rule:line-length
# The static-method-reference twin of 103. A static method reference
# (Integer::valueOf, X::keep, X::triple) compiles to an invokedynamic whose
# target handle is kind 6 (invokestatic) pointing straight at the referenced
# static method, so 111 leaves it native. This rule desugars it into the
# lambda the compiler could have emitted: a private-static lambda$hone$N
# wrapper that just forwards the argument to the referenced method, with the
# invokedynamic repointed at the wrapper. 111 then lifts it; 205/451 fuse it
# where a pointwise predecessor allows, otherwise 712 reverts it to the native
# reference (so nothing is pessimised).
#
# It handles only the adaptation-free case: a SINGLE argument whose type the
# referenced method accepts unchanged and whose return the SAM accepts
# unchanged — i.e. the instantiated SAM type equals the target signature. The
# wrapper body is the straight line `<load arg>; invokestatic C.m (arg)R;
# Xreturn` (single basic block, no frames). The one adaptation that IS covered,
# by the sibling 108, is a return the SAM unboxes (`static Boolean big(Integer)`
# behind a Predicate), which 108 desugars with the `booleanValue()` spelled out.
# Multi-argument refs (Integer::sum), constructor refs, argument boxing and
# return widening do not match either rule and stay native; those are follow-up
# puzzles.
#
# THE RETURN MAY BE VOID, and the `𝑒-return-op` table below has to say so
# (#1053). This rule's `when` gates the ARGUMENT and demands the instantiated
# SAM type equal the target signature; it gates the return not at all, so a
# `peek(X::traced)` over `static void traced(Long)` matches — `Consumer.accept`
# returns void, both signatures read `(Ljava/lang/Long;)V` — and it is the only
# one of these rules that a void return can reach. Without the `V` case the sed
# fell through, the meta kept the literal `V`, and `tau` was asked for an
# attribute by that name; phino answered "Couldn't parse given attribute ...
# unexpected 'V'" and took the WHOLE optimize goal down with it, rather than
# leaving the one class alone. `return` is the opcode, and the max-stack
# arithmetic below needs nothing: `𝑒-widths` concatenates the parameter width
# with the return type, and `1V` and `2V` already fall through to 1 and 2, which
# is what a body that pushes the argument and discards nothing peaks at.
#
# The three siblings with the same table shape were checked and none of them can
# be handed a void return. `103` gates the target signature to `()[IZBCS]`,
# `()J` or `()D`; `107` gates it to `()L` and hard-codes `areturn`; `108`
# enumerates the eight wrapper/primitive pairs, so its bridge return is one of
# `ZBCSIJDF` and its table covers all eight. `105` is the rule that DOES expect
# void, and it hard-codes `Φ.jeo.opcode.return` — but its target must take no
# arguments, so the shape above is not its.
#
# The wrapper lives in the enclosing class, so the handle the invokedynamic is
# repointed at takes its interface flag from that class's `interface` modifier
# (#1116). When the class is an interface the handle must be an
# InterfaceMethodref; with the flag hardcoded to false the JVM threw
# IncompatibleClassChangeError "must be InterfaceMethodref constant" on the
# first call. 111 carries the flag into the lifted lambda's `is-interface`, and
# 711/712 accept either value when they revert an unfused wrapper.
name: static-methodref-to-lambda
pattern: |
  ⟦
    φ ↦ Φ.jeo.class,
    version ↦ 𝑒-class-version,
    access ↦ 𝑒-class-access,
    modifiers ↦ ⟦
      𝐵-class-modifiers-before,
      interface ↦ 𝑒-class-is-interface,
      𝐵-class-modifiers-after
    ⟧,
    name ↦ 𝑒-class,
    supername ↦ 𝑒-class-supername,
    interfaces ↦ 𝑒-class-interfaces,
    𝐵-class-body-head,
    𝜏-function ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 𝑒-method-access,
      modifiers ↦ ⟦
        𝐵-modifiers-before,
        static ↦ 𝑒-static,
        𝐵-modifiers-after
      ⟧,
      name ↦ 𝑒-function,
      descriptor ↦ 𝑒-method-descriptor,
      signature ↦ 𝑒-method-signature,
      exceptions ↦ 𝑒-method-exceptions,
      maxs ↦ 𝑒-method-maxs,
      params ↦ 𝑒-method-params,
      annotations ↦ 𝑒-annotations,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-invokedynamic ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokedynamic,
          𝜏3 ↦ 𝑒-method,
          𝜏4 ↦ 𝑒-interface,
          𝜏5 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏6 ↦ 6,
            𝜏7 ↦ "java/lang/invoke/LambdaMetafactory",
            𝜏8 ↦ "metafactory",
            𝜏9 ↦ "(Ljava/lang/invoke/MethodHandles$Lookup;Ljava/lang/String;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodHandle;Ljava/lang/invoke/MethodType;)Ljava/lang/invoke/CallSite;",
            𝜏10 ↦ Φ.false
          ⟧,
          𝜏11 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏12 ↦ 𝑒-lambda-signature
          ⟧,
          𝜏13 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏14 ↦ 6,
            𝜏15 ↦ 𝑒-target-class,
            𝜏16 ↦ 𝑒-target-method,
            𝜏17 ↦ 𝑒-target-signature,
            𝜏18 ↦ Φ.false
          ⟧,
          𝜏19 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏21 ↦ 𝑒-bridge-signature
          ⟧
        ⟧,
        𝜏-invokeinterface ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokeinterface,
          𝜏24 ↦ 𝑒-stream-class,
          𝜏25 ↦ 𝑒-stream-method,
          𝜏26 ↦ 𝑒-stream-signature,
          𝜏27 ↦ Φ.true
        ⟧,
        𝐵-body-tail
      ⟧,
      𝜏-trycatchblocks ↦ 𝑒-trycatchblocks,
      local-variable-table ↦ 𝑒-lvt
    ⟧,
    𝐵-class-body-tail
  ⟧
result: |
  ⟦
    φ ↦ Φ.jeo.class,
    version ↦ 𝑒-class-version,
    access ↦ 𝑒-class-access,
    modifiers ↦ ⟦
      𝐵-class-modifiers-before,
      interface ↦ 𝑒-class-is-interface,
      𝐵-class-modifiers-after
    ⟧,
    name ↦ 𝑒-class,
    supername ↦ 𝑒-class-supername,
    interfaces ↦ 𝑒-class-interfaces,
    𝐵-class-body-head,
    𝜏-function ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 𝑒-method-access,
      modifiers ↦ ⟦
        𝐵-modifiers-before,
        static ↦ 𝑒-static,
        𝐵-modifiers-after
      ⟧,
      name ↦ 𝑒-function,
      descriptor ↦ 𝑒-method-descriptor,
      signature ↦ 𝑒-method-signature,
      exceptions ↦ 𝑒-method-exceptions,
      maxs ↦ 𝑒-method-maxs,
      params ↦ 𝑒-method-params,
      annotations ↦ 𝑒-annotations,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-invokedynamic ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokedynamic,
          𝜏3 ↦ 𝑒-method,
          𝜏4 ↦ 𝑒-interface,
          𝜏5 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏6 ↦ 6,
            𝜏7 ↦ "java/lang/invoke/LambdaMetafactory",
            𝜏8 ↦ "metafactory",
            𝜏9 ↦ "(Ljava/lang/invoke/MethodHandles$Lookup;Ljava/lang/String;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodHandle;Ljava/lang/invoke/MethodType;)Ljava/lang/invoke/CallSite;",
            𝜏10 ↦ Φ.false
          ⟧,
          𝜏11 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏12 ↦ 𝑒-lambda-signature
          ⟧,
          𝜏13 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏14 ↦ 6,
            𝜏15 ↦ 𝑒-class,
            𝜏16 ↦ 𝑒-wrapper-name,
            𝜏17 ↦ 𝑒-bridge-signature,
            𝜏18 ↦ 𝑒-class-is-interface
          ⟧,
          𝜏19 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏21 ↦ 𝑒-bridge-signature
          ⟧
        ⟧,
        𝜏-invokeinterface ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokeinterface,
          𝜏24 ↦ 𝑒-stream-class,
          𝜏25 ↦ 𝑒-stream-method,
          𝜏26 ↦ 𝑒-stream-signature,
          𝜏27 ↦ Φ.true
        ⟧,
        𝐵-body-tail
      ⟧,
      𝜏-trycatchblocks ↦ 𝑒-trycatchblocks,
      local-variable-table ↦ 𝑒-lvt
    ⟧,
    𝜏-wrapper ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 4106,
      descriptor ↦ 𝑒-bridge-signature,
      signature ↦ "",
      maxs ↦ ⟦
        φ ↦ Φ.jeo.maxs,
        max-stack ↦ 𝑒-max-stack,
        max-locals ↦ 𝑒-max-locals
      ⟧,
      params ↦ ⟦ φ ↦ Φ.jeo.params ⟧,
      body ↦ ⟦
        φ ↦ Φ.jeo.seq.of,
        w-load ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-load, v0 ↦ 0 ⟧,
        w-call ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokestatic,
          v0 ↦ 𝑒-target-class,
          v1 ↦ 𝑒-target-method,
          v2 ↦ 𝑒-target-signature,
          v3 ↦ Φ.false,
          origin ↦ Φ.true
        ⟧,
        w-return ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-return ⟧
      ⟧,
      name ↦ 𝑒-wrapper-name
    ⟧,
    𝐵-class-body-tail
  ⟧
when:
  and:
    - not:
        matches:
          - 'lambda\$.+'
          - 𝑒-target-method
    - matches: ['\(\).+', 𝑒-interface]
    - eq: [𝑒-bridge-signature, 𝑒-target-signature]
    - or:
        - matches: ['\(L[^;]*;\)', 𝑒-bridge-signature]
        - matches: ['\(.\)', 𝑒-bridge-signature]
where:
  - meta: 𝜏-wrapper
    function: random-tau
  - meta: 𝑒-wrapper-name
    function: random-string
    args: ['"lambda$hone$104%d"']
  - meta: 𝑒-param
    function: sed
    args:
      - 𝑒-bridge-signature
      - '"s/\\((.*)\\).*/$1/g"'
  - meta: 𝑒-return
    function: sed
    args:
      - 𝑒-bridge-signature
      - '"s/\\(.*\\)(.+)/$1/g"'
  - meta: 𝑒-load-op
    function: sed
    args:
      - 𝑒-param
      - '"s/^[IZBCS]$/iload/g"'
      - '"s/^J$/lload/g"'
      - '"s/^D$/dload/g"'
      - '"s/^F$/fload/g"'
      - '"s/^(L.+;|\\[.+)$/aload/g"'
  - meta: 𝜏-load
    function: tau
    args: [𝑒-load-op]
  - meta: 𝑒-return-op
    function: sed
    args:
      - 𝑒-return
      - '"s/^[IZBCS]$/ireturn/g"'
      - '"s/^J$/lreturn/g"'
      - '"s/^D$/dreturn/g"'
      - '"s/^F$/freturn/g"'
      - '"s/^(L.+;|\\[.+)$/areturn/g"'
      - '"s/^V$/return/g"'
  - meta: 𝜏-return
    function: tau
    args: [𝑒-return-op]
  - meta: 𝑒-param-width
    function: sed
    args:
      - 𝑒-param
      - '"s/^[JD]$/2/g"'
      - '"s/^[^2].*$/1/g"'
  - meta: 𝑒-max-locals
    function: number
    args: [𝑒-param-width]
  - meta: 𝑒-widths
    function: concat
    args: [𝑒-param-width, 𝑒-return]
  - meta: 𝑒-max-stack-str
    function: sed
    args:
      - 𝑒-widths
      - '"s/^2.*$/2/g"'
      - '"s/^1[JD]$/2/g"'
      - '"s/^1.*$/1/g"'
  - meta: 𝑒-max-stack
    function: number
    args: [𝑒-max-stack-str]
