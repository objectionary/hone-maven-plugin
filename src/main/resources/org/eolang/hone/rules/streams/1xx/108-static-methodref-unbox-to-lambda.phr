---
# yamllint disable rule:line-length
# The unboxing twin of 104. A static method reference whose referenced method
# returns a wrapper where the SAM wants the primitive — `Stream<Integer>
# .dropWhile(X::big)` with `static Boolean big(Integer)`, or `.mapToInt(X::size)`
# with `static Integer size(String)` — compiles to an invokedynamic whose
# instantiated type `(Ljava/lang/Integer;)Z` differs from the target signature
# `(Ljava/lang/Integer;)Ljava/lang/Boolean;`, and LambdaMetafactory inserts the
# `booleanValue()` itself. 104 declines it for exactly that difference
# (`eq: [bridge-signature, target-signature]`), so nothing downstream ever sees
# a Φ.hone.lambda and the whole pipeline splits in two around the reference
# (#974).
#
# This rule synthesises the wrapper the compiler could have emitted and that
# 104 emits for the adaptation-free case, with the unboxing call spelled out:
#
#   <load arg>                            ; the SAM parameter
#   invokestatic C.m (arg)Ljava/lang/Boolean;
#   invokevirtual java/lang/Boolean.booleanValue ()Z
#   ireturn
#
# The wrapper's descriptor IS the instantiated type, so 111 lifts the repointed
# invokedynamic exactly as it lifts 104's, and 201/208 read a `)Z` target off
# it — the ordinary p-filter / dropWhile shape, folded by the ordinary 304/310.
# Nothing in 2xx or 3xx needs to know that a wrapper was ever involved. As with
# 104, a wrapper that does not fuse is reverted to the native reference by 712,
# which keys on the `origin ↦ Φ.true` marker this rule leaves on the forwarding
# call; the unboxing call carries no marker, so 711 cannot mistake it for one.
#
# Only an EXACT unbox is matched. A guard cannot read a `where` meta — phino
# binds those after the match is accepted — so the pairing is spelled out as an
# eight-way alternation over the two signatures rather than computed once and
# compared: `)Ljava/lang/Boolean;` against `)Z`, `)Ljava/lang/Integer;` against
# `)I`, and so on for the other six. An unbox followed by a widening (a `static
# Integer` used as a `ToLongFunction`, where the JDK does `intValue()` then
# `i2l`) pairs with no clause and stays native, which is the point: emitting
# `Integer.longValue()` there would link against a method that does not exist.
#
# The single parameter must be a reference type on BOTH sides, because that is
# the only argument adaptation the straight `aload 0` survives — a reference the
# metafactory would widen (`Integer` where the method takes `Number`) verifies,
# while a primitive one it would box or unbox does not. Boxing the return the
# other way (a primitive-returning method where the SAM wants the wrapper),
# primitive parameters, multi-argument refs and constructor refs stay native;
# those are follow-up puzzles, as they are for 104.
#
# The wrapper lives in the enclosing class, so the handle the invokedynamic is
# repointed at takes its interface flag from that class's `interface` modifier
# (#1116). When the class is an interface the handle must be an
# InterfaceMethodref; with the flag hardcoded to false the JVM threw
# IncompatibleClassChangeError "must be InterfaceMethodref constant" on the
# first call. 111 carries the flag into the lifted lambda's `is-interface`, and
# 711/712 accept either value when they revert an unfused wrapper.
name: static-methodref-unbox-to-lambda
pattern: |
  ⟦
    φ ↦ Φ.jeo.class,
    version ↦ 𝑒-class-version,
    access ↦ 𝑒-class-access,
    modifiers ↦ ⟦
      𝐵-class-modifiers-before,
      interface ↦ 𝑒-class-is-interface,
      𝐵-class-modifiers-after
    ⟧,
    name ↦ 𝑒-class,
    supername ↦ 𝑒-class-supername,
    interfaces ↦ 𝑒-class-interfaces,
    𝐵-class-body-head,
    𝜏-function ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 𝑒-method-access,
      modifiers ↦ ⟦
        𝐵-modifiers-before,
        static ↦ 𝑒-static,
        𝐵-modifiers-after
      ⟧,
      name ↦ 𝑒-function,
      descriptor ↦ 𝑒-method-descriptor,
      signature ↦ 𝑒-method-signature,
      exceptions ↦ 𝑒-method-exceptions,
      maxs ↦ 𝑒-method-maxs,
      params ↦ 𝑒-method-params,
      annotations ↦ 𝑒-annotations,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-invokedynamic ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokedynamic,
          𝜏3 ↦ 𝑒-method,
          𝜏4 ↦ 𝑒-interface,
          𝜏5 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏6 ↦ 6,
            𝜏7 ↦ "java/lang/invoke/LambdaMetafactory",
            𝜏8 ↦ "metafactory",
            𝜏9 ↦ "(Ljava/lang/invoke/MethodHandles$Lookup;Ljava/lang/String;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodHandle;Ljava/lang/invoke/MethodType;)Ljava/lang/invoke/CallSite;",
            𝜏10 ↦ Φ.false,
            ρ ↦ ∅
          ⟧,
          𝜏11 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏12 ↦ 𝑒-lambda-signature,
            ρ ↦ ∅
          ⟧,
          𝜏13 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏14 ↦ 6,
            𝜏15 ↦ 𝑒-target-class,
            𝜏16 ↦ 𝑒-target-method,
            𝜏17 ↦ 𝑒-target-signature,
            𝜏18 ↦ Φ.false,
            ρ ↦ ∅
          ⟧,
          𝜏19 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏21 ↦ 𝑒-bridge-signature,
            ρ ↦ ∅
          ⟧,
          ρ ↦ ∅
        ⟧,
        𝜏-invokeinterface ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokeinterface,
          𝜏24 ↦ 𝑒-stream-class,
          𝜏25 ↦ 𝑒-stream-method,
          𝜏26 ↦ 𝑒-stream-signature,
          𝜏27 ↦ Φ.true,
          ρ ↦ ∅
        ⟧,
        𝐵-body-tail
      ⟧,
      𝜏-trycatchblocks ↦ 𝑒-trycatchblocks,
      local-variable-table ↦ 𝑒-lvt,
      ρ ↦ ∅
    ⟧,
    𝐵-class-body-tail
  ⟧
result: |
  ⟦
    φ ↦ Φ.jeo.class,
    version ↦ 𝑒-class-version,
    access ↦ 𝑒-class-access,
    modifiers ↦ ⟦
      𝐵-class-modifiers-before,
      interface ↦ 𝑒-class-is-interface,
      𝐵-class-modifiers-after
    ⟧,
    name ↦ 𝑒-class,
    supername ↦ 𝑒-class-supername,
    interfaces ↦ 𝑒-class-interfaces,
    𝐵-class-body-head,
    𝜏-function ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 𝑒-method-access,
      modifiers ↦ ⟦
        𝐵-modifiers-before,
        static ↦ 𝑒-static,
        𝐵-modifiers-after
      ⟧,
      name ↦ 𝑒-function,
      descriptor ↦ 𝑒-method-descriptor,
      signature ↦ 𝑒-method-signature,
      exceptions ↦ 𝑒-method-exceptions,
      maxs ↦ 𝑒-method-maxs,
      params ↦ 𝑒-method-params,
      annotations ↦ 𝑒-annotations,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-invokedynamic ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokedynamic,
          𝜏3 ↦ 𝑒-method,
          𝜏4 ↦ 𝑒-interface,
          𝜏5 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏6 ↦ 6,
            𝜏7 ↦ "java/lang/invoke/LambdaMetafactory",
            𝜏8 ↦ "metafactory",
            𝜏9 ↦ "(Ljava/lang/invoke/MethodHandles$Lookup;Ljava/lang/String;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodHandle;Ljava/lang/invoke/MethodType;)Ljava/lang/invoke/CallSite;",
            𝜏10 ↦ Φ.false,
            ρ ↦ ∅
          ⟧,
          𝜏11 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏12 ↦ 𝑒-lambda-signature,
            ρ ↦ ∅
          ⟧,
          𝜏13 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏14 ↦ 6,
            𝜏15 ↦ 𝑒-class,
            𝜏16 ↦ 𝑒-wrapper-name,
            𝜏17 ↦ 𝑒-bridge-signature,
            𝜏18 ↦ 𝑒-class-is-interface,
            ρ ↦ ∅
          ⟧,
          𝜏19 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏21 ↦ 𝑒-bridge-signature,
            ρ ↦ ∅
          ⟧,
          ρ ↦ ∅
        ⟧,
        𝜏-invokeinterface ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokeinterface,
          𝜏24 ↦ 𝑒-stream-class,
          𝜏25 ↦ 𝑒-stream-method,
          𝜏26 ↦ 𝑒-stream-signature,
          𝜏27 ↦ Φ.true,
          ρ ↦ ∅
        ⟧,
        𝐵-body-tail
      ⟧,
      𝜏-trycatchblocks ↦ 𝑒-trycatchblocks,
      local-variable-table ↦ 𝑒-lvt,
      ρ ↦ ∅
    ⟧,
    𝜏-wrapper ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 4106,
      descriptor ↦ 𝑒-bridge-signature,
      signature ↦ "",
      maxs ↦ ⟦
        φ ↦ Φ.jeo.maxs,
        max-stack ↦ 𝑒-max-stack,
        max-locals ↦ 1
      ⟧,
      params ↦ ⟦ φ ↦ Φ.jeo.params ⟧,
      body ↦ ⟦
        φ ↦ Φ.jeo.seq.of,
        w-load ↦ ⟦ φ ↦ Φ.jeo.opcode.aload, v0 ↦ 0 ⟧,
        w-call ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokestatic,
          v0 ↦ 𝑒-target-class,
          v1 ↦ 𝑒-target-method,
          v2 ↦ 𝑒-target-signature,
          v3 ↦ Φ.false,
          origin ↦ Φ.true
        ⟧,
        w-unbox ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokevirtual,
          v0 ↦ 𝑒-box-class,
          v1 ↦ 𝑒-unbox-method,
          v2 ↦ 𝑒-unbox-signature,
          v3 ↦ Φ.false
        ⟧,
        w-return ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-return ⟧,
        ρ ↦ ∅
      ⟧,
      name ↦ 𝑒-wrapper-name
    ⟧,
    𝐵-class-body-tail
  ⟧
when:
  and:
    - not:
        matches:
          - 'lambda\$.+'
          - 𝑒-target-method
    - matches: ['\(\).+', 𝑒-interface]
    - matches: ['^\(L[^;]*;\)', 𝑒-bridge-signature]
    - matches: ['^\(L[^;]*;\)', 𝑒-target-signature]
    - or:
        - and:
            - matches: ['\)Ljava/lang/Boolean;$', 𝑒-target-signature]
            - matches: ['\)Z$', 𝑒-bridge-signature]
        - and:
            - matches: ['\)Ljava/lang/Byte;$', 𝑒-target-signature]
            - matches: ['\)B$', 𝑒-bridge-signature]
        - and:
            - matches: ['\)Ljava/lang/Character;$', 𝑒-target-signature]
            - matches: ['\)C$', 𝑒-bridge-signature]
        - and:
            - matches: ['\)Ljava/lang/Short;$', 𝑒-target-signature]
            - matches: ['\)S$', 𝑒-bridge-signature]
        - and:
            - matches: ['\)Ljava/lang/Integer;$', 𝑒-target-signature]
            - matches: ['\)I$', 𝑒-bridge-signature]
        - and:
            - matches: ['\)Ljava/lang/Long;$', 𝑒-target-signature]
            - matches: ['\)J$', 𝑒-bridge-signature]
        - and:
            - matches: ['\)Ljava/lang/Float;$', 𝑒-target-signature]
            - matches: ['\)F$', 𝑒-bridge-signature]
        - and:
            - matches: ['\)Ljava/lang/Double;$', 𝑒-target-signature]
            - matches: ['\)D$', 𝑒-bridge-signature]
where:
  - meta: 𝜏-wrapper
    function: random-tau
  - meta: 𝑒-wrapper-name
    function: random-string
    args: ['"lambda$hone$108%d"']
  - meta: 𝑒-return
    function: sed
    args:
      - 𝑒-bridge-signature
      - '"s/\\(.*\\)(.+)/$1/g"'
  # "(Ljava/lang/Integer;)Ljava/lang/Boolean;" -> "java/lang/Boolean"
  - meta: 𝑒-box-class
    function: sed
    args:
      - 𝑒-target-signature
      - '"s/\\(.*\\)L(.+);/$1/g"'
  - meta: 𝑒-unbox-method
    function: sed
    args:
      - 𝑒-return
      - '"s/^Z$/booleanValue/g"'
      - '"s/^B$/byteValue/g"'
      - '"s/^C$/charValue/g"'
      - '"s/^S$/shortValue/g"'
      - '"s/^I$/intValue/g"'
      - '"s/^J$/longValue/g"'
      - '"s/^F$/floatValue/g"'
      - '"s/^D$/doubleValue/g"'
  - meta: 𝑒-unbox-signature
    function: concat
    args: ['"()"', 𝑒-return]
  - meta: 𝑒-return-op
    function: sed
    args:
      - 𝑒-return
      - '"s/^[IZBCS]$/ireturn/g"'
      - '"s/^J$/lreturn/g"'
      - '"s/^D$/dreturn/g"'
      - '"s/^F$/freturn/g"'
  - meta: 𝜏-return
    function: tau
    args: [𝑒-return-op]
  - meta: 𝑒-max-stack-str
    function: sed
    args:
      - 𝑒-return
      - '"s/^[JD]$/2/g"'
      - '"s/^[^2].*$/1/g"'
  - meta: 𝑒-max-stack
    function: number
    args: [𝑒-max-stack-str]
