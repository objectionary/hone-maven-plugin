---
# yamllint disable rule:line-length
# The filter twin of 112. Lifts a CAPTURING primitive-filter invokedynamic —
# one 111 declines for its "(I)L…Predicate;" or "(II…)L…Predicate;" factory
# descriptor — into a Φ.hone.cp-filter pragma, the capturing sibling of the
# Φ.hone.p-filter that 201 produces for a predicate whose backing lambda$
# returns Z. Exactly as 112 does for a capturing map, this rule grabs NO push:
# it leaves the whole run of pushes inline in front of the emitted cp-filter and
# seeds two EMPTY accumulators (`state-acc`, `body-acc`). 118 then peels the pushes
# one at a time (right-to-left — it pins the binding immediately in front of the
# pragma), prepending one append to `state-acc` and one fetch to `body-acc` per
# capture, so the captures land in the shared state List in left-to-right order.
# 314 finally assembles the two accumulators into a stateful
# distill whose park/reload body holds every capture below the item exactly as
# the static lambda$ (int…, Integer) signature wants — the same N-ary shape 316
# gives a capturing map.
#
# Scope (issues #655, #659, #661, #668): ANY run of one or more category-1/2
# PRIMITIVE captures (I, J, D — every push a constant-index iload/lload/dload) and
# REFERENCE captures (L…; — an aload), MIXED in any order and any count, so the
# factory descriptor is matched as "(([IJD]|L[^;]+;)+)L…Predicate;" — one guard over
# the whole capture alphabet, the filter mirror of 112's. Arrays ("[…") stay out.
# The predicate is over a Stream<Integer> (instantiated type
# "(Ljava/lang/Integer;)Z") with a handle-6 static lambda$ target. So
# `filter(n -> n > t)` (one int capture), `filter(n -> n > lo && n < hi)` (two int
# captures), `filter(n -> n > x)` over a captured long (one J capture),
# `filter(n -> base.contains(n))` (one reference capture) and
# `filter(n -> base.contains(n) && n > lo)` (a reference and an int) all fuse
# exactly like the original single-capture case.
#
# As in 112, the descriptor's parameter list rides onto the pragma as `captures`,
# one code per capture, and 118 pops the last code off in step with the push it
# peels — so each capture is gathered with its own type known positionally, rather
# than guessed from target.signature's first L-type, which is only right for a lone
# reference and is what limited the filter before #668. A category-2 (J/D) capture
# occupies two stack slots, so its boxing append (123) peaks one slot higher than an
# int's; this rule BUMPS the caller max-stack by 2 whenever the factory descriptor
# carries a J or D capture, exactly as 112 does for the map (see its header for the
# rationale, and for why the peel has to be a single rule).
name: capturing-invokedynamic-to-filter
pattern: |
  ⟦
    φ ↦ Φ.jeo.class,
    version ↦ 𝑒-class-version,
    access ↦ 𝑒-class-access,
    modifiers ↦ 𝑒-class-modifiers,
    name ↦ 𝑒-class,
    supername ↦ 𝑒-class-supername,
    interfaces ↦ 𝑒-class-interfaces,
    𝐵-class-body-head,
    𝜏-function ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 𝑒-method-access,
      modifiers ↦ ⟦
        𝐵-modifiers-before,
        static ↦ 𝑒-static,
        𝐵-modifiers-after
      ⟧,
      name ↦ 𝑒-function,
      descriptor ↦ 𝑒-method-descriptor,
      signature ↦ 𝑒-method-signature,
      exceptions ↦ 𝑒-method-exceptions,
      maxs ↦ ⟦
        φ ↦ Φ.jeo.maxs,
        m1 ↦ 𝑒-max-stack,
        m2 ↦ 𝑒-max-locals
      ⟧,
      params ↦ 𝑒-method-params,
      annotations ↦ 𝑒-annotations,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-invokedynamic ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokedynamic,
          𝜏3 ↦ 𝑒-method,
          𝜏4 ↦ 𝑒-interface,
          𝜏5 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏6 ↦ 6,
            𝜏7 ↦ "java/lang/invoke/LambdaMetafactory",
            𝜏8 ↦ "metafactory",
            𝜏9 ↦ "(Ljava/lang/invoke/MethodHandles$Lookup;Ljava/lang/String;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodHandle;Ljava/lang/invoke/MethodType;)Ljava/lang/invoke/CallSite;",
            𝜏10 ↦ Φ.false,
            ρ ↦ ∅
          ⟧,
          𝜏11 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏12 ↦ 𝑒-lambda-signature,
            ρ ↦ ∅
          ⟧,
          𝜏13 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            𝜏14 ↦ 6,
            𝜏15 ↦ 𝑒-target-class,
            𝜏16 ↦ 𝑒-target-method,
            𝜏17 ↦ 𝑒-target-signature,
            𝜏18 ↦ 𝑒-target-is-interface,
            ρ ↦ ∅
          ⟧,
          𝜏19 ↦ ⟦
            φ ↦ Φ.jeo.type,
            𝜏21 ↦ "(Ljava/lang/Integer;)Z",
            ρ ↦ ∅
          ⟧,
          ρ ↦ ∅
        ⟧,
        𝜏-invokeinterface ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokeinterface,
          𝜏24 ↦ "java/util/stream/Stream",
          𝜏25 ↦ "filter",
          𝜏26 ↦ "(Ljava/util/function/Predicate;)Ljava/util/stream/Stream;",
          𝜏27 ↦ Φ.true,
          ρ ↦ ∅
        ⟧,
        𝐵-body-tail
      ⟧,
      𝜏-trycatchblocks ↦ 𝑒-trycatchblocks,
      local-variable-table ↦ 𝑒-lvt,
      ρ ↦ ∅
    ⟧,
    𝐵-class-body-tail
  ⟧
result: |
  ⟦
    φ ↦ Φ.jeo.class,
    version ↦ 𝑒-class-version,
    access ↦ 𝑒-class-access,
    modifiers ↦ 𝑒-class-modifiers,
    name ↦ 𝑒-class,
    supername ↦ 𝑒-class-supername,
    interfaces ↦ 𝑒-class-interfaces,
    𝐵-class-body-head,
    𝜏-function ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 𝑒-method-access,
      modifiers ↦ ⟦
        𝐵-modifiers-before,
        static ↦ 𝑒-static,
        𝐵-modifiers-after
      ⟧,
      name ↦ 𝑒-function,
      descriptor ↦ 𝑒-method-descriptor,
      signature ↦ 𝑒-method-signature,
      exceptions ↦ 𝑒-method-exceptions,
      maxs ↦ ⟦
        φ ↦ Φ.jeo.maxs,
        m1 ↦ 𝑒-bumped-stack,
        m2 ↦ 𝑒-max-locals
      ⟧,
      params ↦ 𝑒-method-params,
      annotations ↦ 𝑒-annotations,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-cp-filter ↦ ⟦
          φ ↦ Φ.hone.cp-filter,
          state-acc ↦ ⟦ ρ ↦ ∅ ⟧,
          body-acc ↦ ⟦ ρ ↦ ∅ ⟧,
          captures ↦ 𝑒-captures,
          class ↦ 𝑒-class,
          bridge-input ↦ "Ljava/lang/Integer;",
          bridge-output ↦ "Ljava/lang/Integer;",
          accepted ↦ "Ljava/lang/Integer;",
          returned ↦ "Ljava/lang/Integer;",
          static ↦ "true",
          target ↦ ⟦
            handle ↦ 6,
            class ↦ 𝑒-target-class,
            method ↦ 𝑒-target-method,
            signature ↦ 𝑒-target-signature,
            is-interface ↦ 𝑒-target-is-interface
          ⟧
        ⟧,
        𝐵-body-tail
      ⟧,
      𝜏-trycatchblocks ↦ 𝑒-trycatchblocks,
      local-variable-table ↦ 𝑒-lvt,
      ρ ↦ ∅
    ⟧,
    𝐵-class-body-tail
  ⟧
when:
  and:
    - matches:
        - 'lambda\$.+'
        - 𝑒-target-method
    - matches:
        - '\(([IJD]|L[^;]+;)+\)Ljava/util/function/Predicate;'
        - 𝑒-interface
where:
  # The factory descriptor's parameter list — one code per capture, in descriptor
  # order — for 118 to peel positionally; the same channel 112 seeds for 114.
  - meta: 𝑒-captures
    function: sed
    args:
      - 𝑒-interface
      - '"s/[(]//"'
      - '"s/[)].*//"'
  # Bump the caller max-stack by 2 when a category-2 (J/D) primitive capture is
  # present (its relocated 2-slot boxing append, 123, peaks one slot higher
  # than an int append); an int-only or reference capture bumps by 0. The same
  # machinery 112 uses for the capturing map — see its header for the rationale.
  - meta: 𝑒-cap-params
    function: sed
    args:
      - 𝑒-interface
      - '"s/[(]//"'
      - '"s/[)].*//"'
      - '"s/L[^;]*;//g"'
  - meta: 𝑒-bump-str
    function: sed
    args:
      - 𝑒-cap-params
      - '"s/.*[JD].*/2/"'
      - '"s/^[^2].*$/0/"'
      - '"s/^$/0/"'
  - meta: 𝑒-bump
    function: number
    args: [𝑒-bump-str]
  - meta: 𝑒-bumped-stack
    function: sum
    args: [𝑒-max-stack, 𝑒-bump]
  - meta: 𝜏-cp-filter
    function: random-tau
