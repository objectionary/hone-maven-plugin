---
# yamllint disable rule:line-length
# The capturing dropWhile's half of the locality precondition (#971) — see
# `291-local-chain-permits-stateful` for what the precondition is and why the
# mark is a rename rather than an added binding.
#
# This one lives in 1xx rather than beside its siblings for the same reason
# `115` does: `118` PEELS the captured pushes out of the body and into the
# accumulators, and once that has happened the pragma can no longer be turned
# back into the invokedynamic it came from. So locality has to be decided while
# the pushes are still inline — before `118`, and therefore long before `291`.
#
# The `when` block below is `291`'s, character for character, and the two must
# stay that way: a source or terminal recognised by one and not the other would
# make a capturing dropWhile and a plain one disagree about whether the same
# chain is local. `454` keeps its own pair in step the same way and says so.
name: local-chain-permits-cp-dropwhile
pattern: |
  ⟦
    𝐵-before,
    𝜏-source ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-sop,
      𝜏-sclass ↦ 𝑒-sclass,
      𝜏-smethod ↦ 𝑒-smethod,
      𝐵-source-rest
    ⟧,
    𝐵-mid,
    𝜏-cd ↦ ⟦
      φ ↦ Φ.hone.cp-dropWhile,
      state-acc ↦ 𝑒-state-acc,
      body-acc ↦ 𝑒-body-acc,
      skip-acc ↦ 𝑒-skip-acc,
      undo-acc ↦ 𝑒-undo-acc,
      captures ↦ 𝑒-captures,
      class ↦ 𝑒-class,
      bridge-input ↦ 𝑒-bridge-input,
      bridge-output ↦ 𝑒-bridge-output,
      accepted ↦ 𝑒-accepted,
      returned ↦ 𝑒-returned,
      static ↦ 𝑒-static,
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧
    ⟧,
    𝐵-tail,
    𝜏-terminal ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-top,
      𝜏-tclass ↦ 𝑒-tclass,
      𝜏-tmethod ↦ 𝑒-tmethod,
      𝐵-terminal-rest
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-source ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-sop,
      𝜏-sclass ↦ 𝑒-sclass,
      𝜏-smethod ↦ 𝑒-smethod,
      𝐵-source-rest
    ⟧,
    𝐵-mid,
    𝜏-cd ↦ ⟦
      φ ↦ Φ.hone.local-cp-dropWhile,
      state-acc ↦ 𝑒-state-acc,
      body-acc ↦ 𝑒-body-acc,
      skip-acc ↦ 𝑒-skip-acc,
      undo-acc ↦ 𝑒-undo-acc,
      captures ↦ 𝑒-captures,
      class ↦ 𝑒-class,
      bridge-input ↦ 𝑒-bridge-input,
      bridge-output ↦ 𝑒-bridge-output,
      accepted ↦ 𝑒-accepted,
      returned ↦ 𝑒-returned,
      static ↦ 𝑒-static,
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧
    ⟧,
    𝐵-tail,
    𝜏-terminal ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-top,
      𝜏-tclass ↦ 𝑒-tclass,
      𝜏-tmethod ↦ 𝑒-tmethod,
      𝐵-terminal-rest
    ⟧,
    𝐵-after
  ⟧
when:
  and:
    - matches:
        - '^(collect|toList|toArray|count|sum|min|max|average|reduce|forEach|forEachOrdered|findFirst|findAny|anyMatch|allMatch|noneMatch|summaryStatistics)$'
        - 𝑒-tmethod
    - or:
        - and:
            - eq: [𝜏-sop, 'invokestatic']
            - matches: ['^java/util/stream/(Stream|IntStream|LongStream|DoubleStream)$', 𝑒-sclass]
            - matches: ['^(of|ofNullable|empty|iterate|generate|concat|range|rangeClosed)$', 𝑒-smethod]
        - and:
            - eq: [𝜏-sop, 'invokestatic']
            - eq: [𝑒-sclass, '"java/util/Arrays"']
            - eq: [𝑒-smethod, '"stream"']
        - and:
            - matches: ['^java/util/[A-Z][A-Za-z]*$', 𝑒-sclass]
            - eq: [𝑒-smethod, '"stream"']
        - and:
            - matches: ['^java/lang/(String|CharSequence)$', 𝑒-sclass]
            - matches: ['^(chars|codePoints|lines)$', 𝑒-smethod]
