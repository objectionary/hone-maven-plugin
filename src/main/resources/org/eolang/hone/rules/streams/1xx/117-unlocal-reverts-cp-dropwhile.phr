---
# yamllint disable rule:line-length
# The capturing dropWhile that `117-local-chain-permits-cp-dropwhile` could not
# prove local (#971): its stream may have been handed in by a caller who made it
# parallel, and the sticky `int[1]` latch `314` would fuse into races across
# ForkJoin workers. This rule puts the native call back.
#
# It is `115`'s result verbatim, with the trigger changed: that rule fires when
# a `parallel()` call is visible in the method, this one when locality could not
# be established at all. `115`/`116` run first and take the visibly parallel
# chains, `117` marks the provably local remainder, and whatever is left over
# arrives here — still ahead of `118`, so the captured pushes are still inline
# and the factory descriptor is still recoverable from `captures`.
#
# `reverted ↦ Φ.true` stops `113` lifting the rebuilt lambda again, so no cycle
# can spin, and `701` lowers it back to the invokedynamic it came from.
name: unlocal-reverts-cp-dropwhile
pattern: |
  ⟦
    𝐵-before,
    𝜏-cd ↦ ⟦
      φ ↦ Φ.hone.cp-dropWhile,
      state-acc ↦ 𝑒-state-acc,
      body-acc ↦ 𝑒-body-acc,
      skip-acc ↦ 𝑒-skip-acc,
      undo-acc ↦ 𝑒-undo-acc,
      captures ↦ 𝑒-captures,
      class ↦ 𝑒-class,
      bridge-input ↦ 𝑒-bridge-input,
      bridge-output ↦ 𝑒-bridge-output,
      accepted ↦ 𝑒-accepted,
      returned ↦ 𝑒-returned,
      static ↦ 𝑒-static,
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-lambda ↦ ⟦
      φ ↦ Φ.hone.lambda,
      class ↦ 𝑒-class,
      method ↦ "test",
      interface ↦ 𝑒-factory,
      lambda-signature ↦ "(Ljava/lang/Object;)Z",
      bridge-signature ↦ 𝑒-bsig,
      static ↦ "true",
      opcode ↦ "invokestatic",
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧,
      stream ↦ ⟦
        class ↦ "java/util/stream/Stream",
        method ↦ "dropWhile",
        signature ↦ "(Ljava/util/function/Predicate;)Ljava/util/stream/Stream;"
      ⟧,
      reverted ↦ Φ.true
    ⟧,
    𝐵-after
  ⟧
where:
  - meta: 𝑒-bsig
    function: concat
    args: ['"("', 𝑒-bridge-input, '")Z"']
  - meta: 𝑒-factory
    function: concat
    args: ['"("', 𝑒-captures, '")Ljava/util/function/Predicate;"']
  - meta: 𝜏-lambda
    function: random-tau
