---
# yamllint disable rule:line-length
# The cp-filter mirror of 114: peels one captured push off a Φ.hone.cp-filter and
# folds it into the operator's shared-List state. 113 emits the cp-filter with the
# whole run of pushes still inline in front of it, two EMPTY accumulators, and
# `captures` — the factory descriptor's parameter list, one code per capture.
#
# Everything 114's header explains applies verbatim: the binding immediately in
# front of the pragma is the one peeled, so the run is consumed right-to-left and
# the prepends leave the captures in left-to-right order; `captures` loses its last
# code in step with the push and stops the rule when it runs dry; and ONE rule
# covers every capture type because phino gives each rule its own fixpoint and the
# plugin runs a single cycle over the rule list, so per-type peel rules could only
# ever drain a run whose types were already sorted in rule order (issue #668). The
# boxing is deferred to a Φ.hone.cap-box / Φ.hone.cap-fetch marker that 123-126
# expand in place.
#
# 314 then wraps body-acc into the auto emit-shape `dup; astore 1; <fetches>;
# aload 1; invokestatic lambda$; ifne keep`, so the captures sit below the parked
# item exactly as the predicate signature wants, and the keep label still sees a
# lone [item].
name: cp-filter-peel-capture
pattern: |
  ⟦
    𝐵-h,
    𝜏-push ↦ 𝑒-push,
    𝜏-cf ↦ ⟦
      φ ↦ Φ.hone.cp-filter,
      state-acc ↦ ⟦ 𝐵-sacc, ρ ↦ ∅ ⟧,
      body-acc ↦ ⟦ 𝐵-bacc, ρ ↦ ∅ ⟧,
      captures ↦ 𝑒-captures,
      𝐵-cf-tail
    ⟧,
    𝐵-t
  ⟧
result: |
  ⟦
    𝐵-h,
    𝜏-cf ↦ ⟦
      φ ↦ Φ.hone.cp-filter,
      state-acc ↦ ⟦
        𝜏-dup ↦ ⟦ φ ↦ Φ.jeo.opcode.dup ⟧,
        𝜏-load ↦ 𝑒-push,
        𝜏-box ↦ ⟦ φ ↦ Φ.hone.cap-box, code ↦ 𝑒-code ⟧,
        𝜏-add ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokeinterface,
          i2 ↦ "java/util/List",
          i3 ↦ "add",
          i4 ↦ "(Ljava/lang/Object;)Z",
          i5 ↦ Φ.true
        ⟧,
        𝜏-pop ↦ ⟦ φ ↦ Φ.jeo.opcode.pop ⟧,
        𝐵-sacc,
        ρ ↦ ∅
      ⟧,
      body-acc ↦ ⟦
        𝜏-fetch ↦ ⟦ φ ↦ Φ.hone.cap-fetch, code ↦ 𝑒-code ⟧,
        𝐵-bacc,
        ρ ↦ ∅
      ⟧,
      captures ↦ 𝑒-rest,
      𝐵-cf-tail
    ⟧,
    𝐵-t
  ⟧
when:
  matches: ['.+', 𝑒-captures]
where:
  # The LAST capture code, and the list without it — see 114 for why the
  # alternation and the end-anchor keep class names intact.
  - meta: 𝑒-code
    function: sed
    args:
      - 𝑒-captures
      - '"s/^.*?([IJD]|L[^;]*;)$/$1/"'
  - meta: 𝑒-rest
    function: sed
    args:
      - 𝑒-captures
      - '"s/([IJD]|L[^;]*;)$//"'
  - meta: 𝜏-dup
    function: random-tau
  - meta: 𝜏-load
    function: random-tau
  - meta: 𝜏-box
    function: random-tau
  - meta: 𝜏-add
    function: random-tau
  - meta: 𝜏-pop
    function: random-tau
  - meta: 𝜏-fetch
    function: random-tau
