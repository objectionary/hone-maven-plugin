---
# yamllint disable rule:line-length
# Drops the `aload 0` that pushes `this` in front of a lambda the metafactory
# does not capture it for.
#
# The slot is 120, not the 131 this rule was written at: execution order is
# alphabetical by filename, and `121-nonstatic-lambda-to-static` rewrites
# `static ↦ "false"` to `"true"` for every lambda whose interface matches
# `\(\).+`, which is the whole population `111-invokedynamic-to-lambda`
# produces. At 131 there was nothing left with `static ↦ "false"` by the time
# this rule ran, so the `this` push survived, the rule was dead and the
# `pre-distill` branch that `209`, `304`, `305`, `306` and `309` gate on the
# same flag was never reached (#1126). At 120 it sees the flag before `121`
# flips it.
name: 120-remove-this-before-nonstatic-lambda
pattern: |
  ⟦
    𝐵-before,
    𝜏-load-this ↦ ⟦
      φ ↦ Φ.jeo.opcode.aload,
      𝜏-idx ↦ 0
    ⟧,
    𝜏-lambda ↦ ⟦
      φ ↦ Φ.hone.lambda,
      class ↦ 𝑒-class,
      method ↦ 𝑒-method,
      interface ↦ 𝑒-interface,
      lambda-signature ↦ 𝑒-lambda-signature,
      bridge-signature ↦ 𝑒-bridge-signature,
      static ↦ "false",
      opcode ↦ 𝑒-opcode,
      target ↦ 𝑒-target,
      stream ↦ 𝑒-stream
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-lambda ↦ ⟦
      φ ↦ Φ.hone.lambda,
      class ↦ 𝑒-class,
      method ↦ 𝑒-method,
      interface ↦ 𝑒-interface,
      lambda-signature ↦ 𝑒-lambda-signature,
      bridge-signature ↦ 𝑒-bridge-signature,
      static ↦ "false",
      opcode ↦ 𝑒-opcode,
      target ↦ 𝑒-target,
      stream ↦ 𝑒-stream
    ⟧,
    𝐵-after
  ⟧
