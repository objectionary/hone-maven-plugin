---
# yamllint disable rule:line-length
# `226`/`227` for the primitive dropWhile (#982). `310` gives every dropWhile a
# one-cell `int[1]` sticky latch in a captured list, and that latch is read and
# written with no synchronisation by whichever ForkJoin worker happens to run
# the fused BiConsumer. On a parallel stream several of them do, so the wrong
# items are dropped and the answer changes run to run — the race `222`/`223`
# (skip), `224`/`225` (distinct) and `226`/`227` (the object dropWhile) already
# guard against. `IntStream.parallel()` reaches the same latch by the same
# route, so it needs the same guard.
#
# What differs is WHERE the guard sits. `226` reverts a Φ.hone.dropWhile, which
# on the primitive path only exists from `233` onwards — by then `211` has
# already wrapped the operation in `Φ.hone.box`/`Φ.hone.unbox`, and reverting
# there would leave a native `Stream.dropWhile` sandwiched between a `boxed()`
# and a `mapToInt`: correct, but a boxing detour around code javac had written
# without one. So this pair runs at `210`, after `208`'s primitive sibling mints
# the pragma and before `211` sees it, and puts back the primitive call exactly
# as it was found.
#
# Everything the revert needs is on the pragma. `stream-class` names the stream
# interface, and the SAM follows from the bridge signature alone — `(I)Z` means
# `IntPredicate`, `(J)Z` `LongPredicate`, `(D)Z` `DoublePredicate` — because
# `208`'s primitive sibling pins the two together arm by arm and refuses any
# other quartet. `lambda-signature` is the bridge signature itself on a
# primitive SAM, which is why there is no erasure to undo here the way `226`
# has to spell out `(Ljava/lang/Object;)Z`. The `reverted ↦ Φ.true` marker stops
# `208` from lifting the result again, so the pair cannot cycle; `701` absorbs
# the marker through its trailing wildcard and lowers the lambda back to the
# invokedynamic it came from.
#
# Detection is over-broad on purpose, exactly as `222` and `226` are: any
# `parallel`/`parallelStream` anywhere in the method reverts every primitive
# dropWhile in it, even one on an unrelated sequential stream. That only
# forfeits an optimisation, so erring this way keeps the pass sound. This rule
# covers a parallel call BEFORE the dropWhile
# (`IntStream.of(..).parallel().dropWhile(p)`); its sibling
# `210-parallel-reverts-primitive-dropwhile-after` covers the call after it.
# Binding groups are order-preserving, so both layouts need their own rule.
name: parallel-reverts-primitive-dropwhile
pattern: |
  ⟦
    𝐵-before,
    𝜏-parallel ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-op,
      𝜏-pclass ↦ 𝑒-pclass,
      𝜏-pmethod ↦ 𝑒-pmethod,
      𝐵-parallel-rest
    ⟧,
    𝐵-between,
    𝜏-dropwhile ↦ ⟦
      φ ↦ Φ.hone.primitive-dropWhile,
      opcode ↦ 𝑒-opcode,
      class ↦ 𝑒-class,
      stream-class ↦ 𝑒-stream-class,
      bridge-signature ↦ 𝑒-bridge-signature,
      static ↦ 𝑒-static,
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-parallel ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-op,
      𝜏-pclass ↦ 𝑒-pclass,
      𝜏-pmethod ↦ 𝑒-pmethod,
      𝐵-parallel-rest
    ⟧,
    𝐵-between,
    𝜏-lambda ↦ ⟦
      φ ↦ Φ.hone.lambda,
      class ↦ 𝑒-class,
      method ↦ "test",
      interface ↦ 𝑒-interface,
      lambda-signature ↦ 𝑒-bridge-signature,
      bridge-signature ↦ 𝑒-bridge-signature,
      static ↦ 𝑒-static,
      opcode ↦ 𝑒-opcode,
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧,
      stream ↦ ⟦
        class ↦ 𝑒-stream-class,
        method ↦ "dropWhile",
        signature ↦ 𝑒-stream-signature
      ⟧,
      reverted ↦ Φ.true
    ⟧,
    𝐵-after
  ⟧
when:
  and:
    - or:
        - and:
            - or:
                - eq: [𝜏-op, 'invokeinterface']
                - eq: [𝜏-op, 'invokevirtual']
            - matches: ['^(parallel|parallelStream)$', 𝑒-pmethod]
        - and:
            - eq: [𝑒-pclass, '"java/util/stream/StreamSupport"']
            - matches: ['^(stream|intStream|longStream|doubleStream)$', 𝑒-pmethod]
where:
  - meta: 𝑒-sam
    function: sed
    # "(I)Z" -> "Int", so the SAM follows from the bridge signature alone
    args:
      - 𝑒-bridge-signature
      - '"s/\\(I\\)Z/Int/g"'
      - '"s/\\(J\\)Z/Long/g"'
      - '"s/\\(D\\)Z/Double/g"'
  - meta: 𝑒-interface
    function: concat
    # "()Ljava/util/function/IntPredicate;"
    args: ['"()Ljava/util/function/"', 𝑒-sam, '"Predicate;"']
  - meta: 𝑒-stream-signature
    function: concat
    # "(Ljava/util/function/IntPredicate;)Ljava/util/stream/IntStream;"
    args: ['"(Ljava/util/function/"', 𝑒-sam, '"Predicate;)L"', 𝑒-stream-class, '";"']
  - meta: 𝜏-lambda
    function: random-tau
