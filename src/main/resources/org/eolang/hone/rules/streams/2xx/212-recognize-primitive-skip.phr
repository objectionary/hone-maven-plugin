---
# yamllint disable rule:line-length
# The primitive twin of `220-recognize-skip` (#996), and the sibling of
# `212-recognize-primitive-distinct`: `220` pins `java/util/stream/Stream` on
# the call, so an `IntStream.skip(n)` stayed a native call and split the
# pipeline around it. Its header explains the rest of the shape, and why the
# boxing sandwich these two pragmas need is built by `214` rather than by
# `211`.
#
# Like `220`, this rule absorbs the long-constant push javac emits immediately
# in front of the call (`lconst_0`, `lconst_1` or `ldc {long}`) and carries it
# on the pragma, so `308` can bake it into the countdown counter and `442`
# recover it when reverting an unfused skip. The push is captured as a whole
# `Φ.jeo.opcode.*` object, so a stray label or debug entry can never be
# mistaken for it — `151` has already stripped line-numbers and
# `219-remove-label-before-skip` (widened to this interface by #996) has
# removed the own-line label, so the push always sits immediately before the
# call. The count must be a COMPILE-TIME CONSTANT, and the `when` below is what
# makes that true rather than merely intended: `220`'s header carries the
# argument (#969), and the guard here is the same one — `lconst_0`, `lconst_1`
# or `ldc`, the three opcodes that push a long on their own. Anything computed
# is left plain bytecode.
#
# All three primitive stream interfaces, for the reason
# `212-recognize-primitive-distinct` records: #1012 fixed the slot layout and
# #1016 the boxing seam, and with both closed the lift widens.
name: recognize-primitive-skip
pattern: |
  ⟦
    φ ↦ Φ.jeo.class,
    𝐵-class-head-before,
    name ↦ 𝑒-class-name,
    𝐵-class-head-after,
    𝜏-caller ↦ ⟦
      φ ↦ Φ.jeo.method,
      𝐵-caller-head,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-push ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-pop, 𝐵-push-rest ⟧,
        𝜏-invokeinterface ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokeinterface,
          𝜏1 ↦ 𝑒-stream-class,
          𝜏2 ↦ "skip",
          𝜏3 ↦ 𝑒-signature,
          𝜏4 ↦ Φ.true,
          ρ ↦ ∅
        ⟧,
        𝐵-body-tail
      ⟧,
      𝐵-caller-tail
    ⟧,
    𝐵-class-tail,
    ρ ↦ ∅
  ⟧
result: |
  ⟦
    φ ↦ Φ.jeo.class,
    𝐵-class-head-before,
    name ↦ 𝑒-class-name,
    𝐵-class-head-after,
    𝜏-caller ↦ ⟦
      φ ↦ Φ.jeo.method,
      𝐵-caller-head,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-skip ↦ ⟦
          φ ↦ Φ.hone.primitive-skip,
          class ↦ 𝑒-class-name,
          stream-class ↦ 𝑒-stream-class,
          push ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-pop, 𝐵-push-rest ⟧
        ⟧,
        𝐵-body-tail
      ⟧,
      𝐵-caller-tail
    ⟧,
    𝐵-class-tail,
    ρ ↦ ∅
  ⟧
where:
  - meta: 𝜏-skip
    function: random-tau
  - meta: 𝑒-signature
    function: concat
    args: ['"(J)L"', 𝑒-stream-class, '";"']
when:
  and:
    - or:
        - eq: [𝜏-pop, 'lconst_0']
        - eq: [𝜏-pop, 'lconst_1']
        - eq: [𝜏-pop, 'ldc']
    - or:
        - eq: [𝑒-stream-class, '"java/util/stream/IntStream"']
        - eq: [𝑒-stream-class, '"java/util/stream/LongStream"']
        - eq: [𝑒-stream-class, '"java/util/stream/DoubleStream"']
