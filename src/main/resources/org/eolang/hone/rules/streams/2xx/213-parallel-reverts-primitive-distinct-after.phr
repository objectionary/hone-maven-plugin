---
# yamllint disable rule:line-length
# The `225` of `213-parallel-reverts-primitive-distinct`: the parallel call
# AFTER the distinct (#996). Binding groups are order-preserving, so the two
# layouts need their own rules; the header of the `-before` rule carries the
# argument.
name: parallel-reverts-primitive-distinct-after
pattern: |
  ⟦
    𝐵-before,
    𝜏-lifted ↦ ⟦
      φ ↦ Φ.hone.primitive-distinct,
      class ↦ 𝑒-class,
      stream-class ↦ 𝑒-stream-class
    ⟧,
    𝐵-between,
    𝜏-parallel ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-op,
      𝜏-pclass ↦ 𝑒-pclass,
      𝜏-pmethod ↦ 𝑒-pmethod,
      𝐵-parallel-rest
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-call ↦ ⟦
      φ ↦ Φ.jeo.opcode.invokeinterface,
      i2 ↦ 𝑒-stream-class,
      i3 ↦ "distinct",
      i4 ↦ 𝑒-signature,
      i5 ↦ Φ.true,
      reverted ↦ Φ.true
    ⟧,
    𝐵-between,
    𝜏-parallel ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-op,
      𝜏-pclass ↦ 𝑒-pclass,
      𝜏-pmethod ↦ 𝑒-pmethod,
      𝐵-parallel-rest
    ⟧,
    𝐵-after
  ⟧
when:
  and:
    - or:
        - and:
            - or:
                - eq: [𝜏-op, 'invokeinterface']
                - eq: [𝜏-op, 'invokevirtual']
            - matches: ['^(parallel|parallelStream)$', 𝑒-pmethod]
        - and:
            - eq: [𝑒-pclass, '"java/util/stream/StreamSupport"']
            - matches: ['^(stream|intStream|longStream|doubleStream)$', 𝑒-pmethod]
where:
  - meta: 𝜏-call
    function: random-tau
  - meta: 𝑒-signature
    function: concat
    args: ['"()L"', 𝑒-stream-class, '";"']
