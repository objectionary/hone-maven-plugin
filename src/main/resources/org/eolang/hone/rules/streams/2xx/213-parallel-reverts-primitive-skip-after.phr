---
# yamllint disable rule:line-length
# The `223` of `213-parallel-reverts-primitive-skip`: the parallel call AFTER
# the skip (#996). Binding groups are order-preserving, so the two layouts need
# their own rules; the header of the `-before` rule carries the argument.
name: parallel-reverts-primitive-skip-after
pattern: |
  ⟦
    𝐵-before,
    𝜏-lifted ↦ ⟦
      φ ↦ Φ.hone.primitive-skip,
      class ↦ 𝑒-class,
      stream-class ↦ 𝑒-stream-class,
      push ↦ 𝑒-push
    ⟧,
    𝐵-between,
    𝜏-parallel ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-op,
      𝜏-pclass ↦ 𝑒-pclass,
      𝜏-pmethod ↦ 𝑒-pmethod,
      𝐵-parallel-rest
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-push-back ↦ 𝑒-push,
    𝜏-call ↦ ⟦
      φ ↦ Φ.jeo.opcode.invokeinterface,
      i2 ↦ 𝑒-stream-class,
      i3 ↦ "skip",
      i4 ↦ "(J)Ljava/util/stream/IntStream;",
      i5 ↦ Φ.true,
      reverted ↦ Φ.true
    ⟧,
    𝐵-between,
    𝜏-parallel ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-op,
      𝜏-pclass ↦ 𝑒-pclass,
      𝜏-pmethod ↦ 𝑒-pmethod,
      𝐵-parallel-rest
    ⟧,
    𝐵-after
  ⟧
when:
  and:
    - or:
        - eq: [𝜏-op, 'invokeinterface']
        - eq: [𝜏-op, 'invokevirtual']
    - matches: ['^(parallel|parallelStream)$', 𝑒-pmethod]
where:
  - meta: 𝜏-call
    function: random-tau
  - meta: 𝜏-push-back
    function: random-tau
