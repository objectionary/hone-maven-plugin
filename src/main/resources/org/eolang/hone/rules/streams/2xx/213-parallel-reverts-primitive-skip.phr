---
# yamllint disable rule:line-length
# The skip half of `213-parallel-reverts-primitive-distinct` (#996), and the
# primitive analogue of `222-parallel-reverts-skip`. `222`'s header carries the
# argument — the countdown a fused skip keeps is a plain `long[1]`, raced
# rather than merely unstable, so a parallel pipeline must keep the native
# call — and `213-parallel-reverts-primitive-distinct` explains why the revert
# happens here, ahead of `214`'s boxing, rather than inside the sandwich.
#
# A skip revert is two opcodes: the count push `212` absorbed comes back out in
# front of the call, in the order javac emitted it.
name: parallel-reverts-primitive-skip
pattern: |
  ⟦
    𝐵-before,
    𝜏-parallel ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-op,
      𝜏-pclass ↦ 𝑒-pclass,
      𝜏-pmethod ↦ 𝑒-pmethod,
      𝐵-parallel-rest
    ⟧,
    𝐵-between,
    𝜏-lifted ↦ ⟦
      φ ↦ Φ.hone.primitive-skip,
      class ↦ 𝑒-class,
      stream-class ↦ 𝑒-stream-class,
      push ↦ 𝑒-push
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-parallel ↦ ⟦
      φ ↦ Φ.jeo.opcode.𝜏-op,
      𝜏-pclass ↦ 𝑒-pclass,
      𝜏-pmethod ↦ 𝑒-pmethod,
      𝐵-parallel-rest
    ⟧,
    𝐵-between,
    𝜏-push-back ↦ 𝑒-push,
    𝜏-call ↦ ⟦
      φ ↦ Φ.jeo.opcode.invokeinterface,
      i2 ↦ 𝑒-stream-class,
      i3 ↦ "skip",
      i4 ↦ "(J)Ljava/util/stream/IntStream;",
      i5 ↦ Φ.true,
      reverted ↦ Φ.true
    ⟧,
    𝐵-after
  ⟧
when:
  and:
    - or:
        - eq: [𝜏-op, 'invokeinterface']
        - eq: [𝜏-op, 'invokevirtual']
    - matches: ['^(parallel|parallelStream)$', 𝑒-pmethod]
where:
  - meta: 𝜏-call
    function: random-tau
  - meta: 𝜏-push-back
    function: random-tau
