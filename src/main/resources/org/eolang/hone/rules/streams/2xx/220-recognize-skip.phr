---
# yamllint disable rule:line-length
# Recognises a stream `.skip(n)` call — the long-constant push followed by
# the bare `invokeinterface java/util/stream/Stream.skip:(J)…Stream;` opcode
# — and abstracts the pair into a single Φ.hone.skip pragma. Like
# distinct (216) skip carries no lambda, so it has no class of its own; the
# pattern matches at class scope to capture the enclosing class name, which
# 308 needs on the resulting distill so 401-fuse can compose it with the
# neighbouring map/filter distills (they share one `class`).
#
# Unlike distinct, skip takes an argument: the long count javac pushes with
# a single opcode (`lconst_0`, `lconst_1` or `ldc {long}`) immediately before
# the call. That opcode is captured (constrained to a `Φ.jeo.opcode.*` so a
# stray debug entry can never be mistaken for it) and carried on the pragma so
# 308 can bake it into the countdown counter; 442 recovers it from there when
# reverting an unfused skip.
#
# A single rule suffices because the prep pass has already normalised the
# code: 151 strips line-numbers and 219 removes the leftover own-line label
# between the count-push and the call, so the count-push always sits
# immediately before the call — whether or not `.skip(n)` was written on its
# own source line.
#
# The count MUST be a compile-time constant, and the `when` below is what makes
# that true rather than merely intended (#969). `𝜏-pop` is a metavariable over
# the opcode NAME, so without a guard it matches `lsub`, `i2l`, `lload` or
# anything else as happily as `lconst_1`: for `stream.skip(list.size())` javac
# emits `invokeinterface java/util/List.size:()I`, `i2l`, then the call, and the
# rule took the `i2l`. `308` splices whatever is captured verbatim into the
# state prologue, where the stack holds the captured java/util/List, so the
# prologue tried to widen a list reference to a long and left the `size()`
# result orphaned — a class that fails verification, and `442` replays the same
# wrong opcode when reverting, so the fallback did not rescue it either. The
# guard admits exactly the three opcodes that push a long constant on their
# own: `lconst_0`, `lconst_1` and `ldc` (jeo normalises javac's `ldc2_w` to
# `ldc`). Every other shape is left plain bytecode, which is what the rule
# always claimed to do.
#
# The same guard is on `212-recognize-primitive-skip`, which lifts the
# `IntStream` call with the same pattern.
name: recognize-skip
pattern: |
  ⟦
    φ ↦ Φ.jeo.class,
    𝐵-class-head-before,
    name ↦ 𝑒-class-name,
    𝐵-class-head-after,
    𝜏-caller ↦ ⟦
      φ ↦ Φ.jeo.method,
      𝐵-caller-head,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-push ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-pop, 𝐵-push-rest ⟧,
        𝜏-invokeinterface ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokeinterface,
          𝜏1 ↦ "java/util/stream/Stream",
          𝜏2 ↦ "skip",
          𝜏3 ↦ "(J)Ljava/util/stream/Stream;",
          𝜏4 ↦ Φ.true
        ⟧,
        𝐵-body-tail
      ⟧,
      𝐵-caller-tail
    ⟧,
    𝐵-class-tail
  ⟧
result: |
  ⟦
    φ ↦ Φ.jeo.class,
    𝐵-class-head-before,
    name ↦ 𝑒-class-name,
    𝐵-class-head-after,
    𝜏-caller ↦ ⟦
      φ ↦ Φ.jeo.method,
      𝐵-caller-head,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-skip ↦ ⟦
          φ ↦ Φ.hone.skip,
          class ↦ 𝑒-class-name,
          stream-class ↦ "java/util/stream/Stream",
          push ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-pop, 𝐵-push-rest ⟧
        ⟧,
        𝐵-body-tail
      ⟧,
      𝐵-caller-tail
    ⟧,
    𝐵-class-tail
  ⟧
where:
  - meta: 𝜏-skip
    function: random-tau
when:
  or:
    - eq: [𝜏-pop, 'lconst_0']
    - eq: [𝜏-pop, 'lconst_1']
    - eq: [𝜏-pop, 'ldc']
