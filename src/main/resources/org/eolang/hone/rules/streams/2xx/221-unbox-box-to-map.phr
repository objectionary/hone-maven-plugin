---
# yamllint disable rule:line-length
# Collapses an unbox immediately followed by a box back into a single object
# map. This is the cleanup for the box/unbox pair `211` synthesises when it
# splits a primitive IntStream.filter/map chain (box + boxed-primitive-func +
# unbox) and for the one `214` puts around a lifted distinct or skip: where two
# split ops meet, the tail unbox of one and the head box of the next cancel,
# and so does the head box `211` wedges right after a user `mapToInt(ref)` that
# feeds a primitive op, and the one `208-mapToObj` mints for the crossing.
#
# The box pattern is CLOSED and carries no `user ↦ Φ.true`, which is what keeps
# the user's own `boxed()` out of it (#1016). The older reading — that `209`
# has already folded away every genuine `mapToX(...).boxed()` round trip, so
# whatever box is left here must be synthetic — is simply not true: `209` only
# folds a `boxed()` that an unbox feeds, and a `boxed()` written straight
# behind a primitive `distinct()` or `skip()` reaches this rule intact.
# Cancelling it dropped the user's own boxing, left the run primitive-out while
# the caller held a `Stream`, and `501` then emitted `mapMultiToInt` for it —
# an `IncompatibleClassChangeError` at the first element.
#
# The one user box that IS dead on arrival — a `boxed()` with the user's own
# `mapToX` right behind it — is cancelled by `221-unbox-user-box-to-map`
# instead, which pins that following unbox in its pattern.
name: unbox-box-to-map
pattern: |
  ⟦
    𝐵-before,
    𝜏-unbox ↦ ⟦
      φ ↦ Φ.hone.unbox,
      opcode ↦ 𝑒-opcode,
      class ↦ 𝑒-class,
      bridge-signature ↦ 𝑒-bridge-signature,
      static ↦ 𝑒-static,
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧
    ⟧,
    𝜏-box ↦ ⟦
      φ ↦ Φ.hone.box,
      stream-class ↦ 𝑒-stream-class
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-map ↦ ⟦
      φ ↦ Φ.hone.map,
      opcode ↦ 𝑒-opcode,
      class ↦ 𝑒-class,
      bridge-input ↦ 𝑒-bridge-input,
      bridge-output ↦ 𝑒-bridge-output,
      accepted ↦ 𝑒-accepted,
      returned ↦ 𝑒-returned,
      static ↦ 𝑒-static,
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧
    ⟧,
    𝐵-after
  ⟧
where:
  - meta: 𝜏-map
    function: random-tau
  - meta: 𝑒-bridge-input
    function: sed
    args:
      - 𝑒-bridge-signature
      - '"s/\\((.*)\\).*/$1/g"'
  - meta: 𝑒-bridge-output
    function: sed
    # "(Ljava/lang/String;)Ljava/lang/Integer;"
    args:
      - 𝑒-bridge-signature
      - '"s/\\(.*\\)(.+)/$1/g"'
  - meta: 𝑒-target-class-pattern
    function: sed
    # java\\/lang\\/String
    args:
      - 𝑒-target-class
      - '"s/\\//\\\\\\//g"'
  - meta: 𝑒-virtual-accepted-pattern
    function: concat
    # s/\\(\\).+/Ljava\\/lang\\/String;/g
    args: ['"s/\\(\\).+/L"', 𝑒-target-class-pattern, '";/g"']
  - meta: 𝑒-bridge-input-pattern
    function: sed
    # Ljava\\/lang\\/String;
    args:
      - 𝑒-bridge-input
      - '"s/\\//\\\\\\//g"'
  - meta: 𝑒-java-object-pattern
    function: concat
    # s/\\(Ljava\\/lang\\/Object;\\).+/Ljava\\/lang\\/String;/g
    args: ['"s/\\(Ljava\\/lang\\/Object;\\).+/"', 𝑒-bridge-input-pattern, '"/g"']
  - meta: 𝑒-accepted
    function: sed
    args:
      - 𝑒-target-signature
      - 𝑒-virtual-accepted-pattern
      - 𝑒-java-object-pattern
      - '"s/\\((.+)\\).+/$1/g"'
  - meta: 𝑒-returned
    function: sed
    args:
      - 𝑒-target-signature
      - '"s/\\(.*\\)(.+)/$1/g"'
