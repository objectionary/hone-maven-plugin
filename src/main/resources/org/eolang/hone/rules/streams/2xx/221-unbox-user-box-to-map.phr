---
# yamllint disable rule:line-length
# The companion of `221-unbox-box-to-map`, for the one user box that IS safe to
# cancel an unbox against: a `boxed()` whose value the user's own `mapToX`
# consumes on the very next step. `221-unbox-box-to-map` takes only a box with
# no `user ↦ Φ.true` on it, because a user `boxed()` that survives into the rest
# of the pipeline is the caller's element type and cancelling it loses the
# boxing (#1016). A `boxed()` with an unbox right behind it is not that: the
# round trip is dead on arrival — box it, unbox it again — so the seam merges
# and the trailing unbox stays where it was, for `451` to fuse into the distill
# later.
#
# `boxed-filter-tail.yml` is the shape, and the reason this rule exists: a
# primitive `filter` whose `boxed()` feeds a `mapToInt(Double::intValue)` with
# nothing in between. `211` splits the filter into box + boxed-primitive-filter
# + unbox and `205` has already lifted the methodref into an unbox, which puts
# unbox / box / unbox in a row; cancelling the first pair is what keeps the
# whole run inside one distill and lets `501` lower it to a single
# `mapMultiToInt`. Without this rule the run breaks in two and the class ends
# up with twice the invokedynamic it needs.
#
# It pins `user ↦ Φ.true`, so the only box it ever takes is one `206` lifted
# from a `boxed()` the user wrote; the synthetic ones are `221-unbox-box-to-map`
# territory whether or not an unbox follows.
name: unbox-user-box-to-map
pattern: |
  ⟦
    𝐵-before,
    𝜏-unbox ↦ ⟦
      φ ↦ Φ.hone.unbox,
      opcode ↦ 𝑒-opcode,
      class ↦ 𝑒-class,
      bridge-signature ↦ 𝑒-bridge-signature,
      static ↦ 𝑒-static,
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧
    ⟧,
    𝜏-box ↦ ⟦
      φ ↦ Φ.hone.box,
      stream-class ↦ 𝑒-stream-class,
      user ↦ Φ.true
    ⟧,
    𝜏-next ↦ ⟦
      φ ↦ Φ.hone.unbox,
      𝐵-next-rest
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-map ↦ ⟦
      φ ↦ Φ.hone.map,
      opcode ↦ 𝑒-opcode,
      class ↦ 𝑒-class,
      bridge-input ↦ 𝑒-bridge-input,
      bridge-output ↦ 𝑒-bridge-output,
      accepted ↦ 𝑒-accepted,
      returned ↦ 𝑒-returned,
      static ↦ 𝑒-static,
      target ↦ ⟦
        handle ↦ 𝑒-target-handle,
        class ↦ 𝑒-target-class,
        method ↦ 𝑒-target-method,
        signature ↦ 𝑒-target-signature,
        is-interface ↦ 𝑒-target-is-interface
      ⟧
    ⟧,
    𝜏-next ↦ ⟦
      φ ↦ Φ.hone.unbox,
      𝐵-next-rest
    ⟧,
    𝐵-after
  ⟧
where:
  - meta: 𝜏-map
    function: random-tau
  - meta: 𝑒-bridge-input
    function: sed
    args:
      - 𝑒-bridge-signature
      - '"s/\\((.*)\\).*/$1/g"'
  - meta: 𝑒-bridge-output
    function: sed
    # "(Ljava/lang/String;)Ljava/lang/Integer;"
    args:
      - 𝑒-bridge-signature
      - '"s/\\(.*\\)(.+)/$1/g"'
  - meta: 𝑒-target-class-pattern
    function: sed
    # java\\/lang\\/String
    args:
      - 𝑒-target-class
      - '"s/\\//\\\\\\//g"'
  - meta: 𝑒-virtual-accepted-pattern
    function: concat
    # s/\\(\\).+/Ljava\\/lang\\/String;/g
    args: ['"s/\\(\\).+/L"', 𝑒-target-class-pattern, '";/g"']
  - meta: 𝑒-bridge-input-pattern
    function: sed
    # Ljava\\/lang\\/String;
    args:
      - 𝑒-bridge-input
      - '"s/\\//\\\\\\//g"'
  - meta: 𝑒-java-object-pattern
    function: concat
    # s/\\(Ljava\\/lang\\/Object;\\).+/Ljava\\/lang\\/String;/g
    args: ['"s/\\(Ljava\\/lang\\/Object;\\).+/"', 𝑒-bridge-input-pattern, '"/g"']
  - meta: 𝑒-accepted
    function: sed
    args:
      - 𝑒-target-signature
      - 𝑒-virtual-accepted-pattern
      - 𝑒-java-object-pattern
      - '"s/\\((.+)\\).+/$1/g"'
  - meta: 𝑒-returned
    function: sed
    args:
      - 𝑒-target-signature
      - '"s/\\(.*\\)(.+)/$1/g"'
