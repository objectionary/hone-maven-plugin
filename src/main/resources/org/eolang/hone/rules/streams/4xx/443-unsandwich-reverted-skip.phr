---
# yamllint disable rule:line-length
# The skip sibling of `443-unsandwich-reverted-distinct` (#996); its header
# carries the argument, including why the opcode this rule emits is stamped
# `reverted`.
#
# One difference: a skip revert is TWO opcodes, not one. `442` puts the count
# push back in front of the call, so the sandwich to collapse is box, push,
# call, unbox — and the push comes back out with the call, in the same order
# `212` absorbed it.
#
# The box pattern carries a trailing `𝐵-box-rest` so the `user ↦ Φ.true`
# stamp `206` puts on a real `boxed()` (#1016) does not close it: this rule
# takes a box of either provenance, exactly as it did before the stamp.
name: unsandwich-reverted-skip
pattern: |
  ⟦
    𝐵-before,
    𝜏-box ↦ ⟦
      φ ↦ Φ.hone.box,
      stream-class ↦ 𝑒-stream-class,
      𝐵-box-rest
    ⟧,
    𝜏-push ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-pop, 𝐵-push-rest ⟧,
    𝜏-skip ↦ ⟦
      φ ↦ Φ.jeo.opcode.invokeinterface,
      𝜏1 ↦ "java/util/stream/Stream",
      𝜏2 ↦ "skip",
      𝜏3 ↦ "(J)Ljava/util/stream/Stream;",
      𝜏4 ↦ Φ.true,
      reverted ↦ Φ.true,
      ρ ↦ ∅
    ⟧,
    𝜏-unbox ↦ ⟦
      φ ↦ Φ.hone.unbox,
      opcode ↦ 𝑒-unbox-opcode,
      class ↦ 𝑒-unbox-class,
      bridge-signature ↦ 𝑒-unbox-bridge,
      static ↦ "true",
      target ↦ 𝑒-unbox-target
    ⟧,
    𝐵-after
  ⟧
result: |
  ⟦
    𝐵-before,
    𝜏-push-back ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-pop, 𝐵-push-rest ⟧,
    𝜏-native ↦ ⟦
      φ ↦ Φ.jeo.opcode.invokeinterface,
      i2 ↦ 𝑒-stream-class,
      i3 ↦ "skip",
      i4 ↦ 𝑒-native-signature,
      i5 ↦ Φ.true,
      reverted ↦ Φ.true
    ⟧,
    𝐵-after
  ⟧
where:
  - meta: 𝑒-wrapper
    function: sed
    args:
      - 𝑒-stream-class
      - '"s/^java\\/util\\/stream\\/IntStream$/java\\/lang\\/Integer/g"'
      - '"s/^java\\/util\\/stream\\/LongStream$/java\\/lang\\/Long/g"'
      - '"s/^java\\/util\\/stream\\/DoubleStream$/java\\/lang\\/Double/g"'
  - meta: 𝑒-primitive
    function: sed
    args:
      - 𝑒-stream-class
      - '"s/^java\\/util\\/stream\\/IntStream$/I/g"'
      - '"s/^java\\/util\\/stream\\/LongStream$/J/g"'
      - '"s/^java\\/util\\/stream\\/DoubleStream$/D/g"'
  - meta: 𝑒-unbox-bridge
    function: concat
    args: ['"(L"', 𝑒-wrapper, '";)"', 𝑒-primitive]
  - meta: 𝑒-native-signature
    function: concat
    args: ['"(J)L"', 𝑒-stream-class, '";"']
  - meta: 𝜏-push-back
    function: random-tau
  - meta: 𝜏-native
    function: random-tau
when:
  or:
    - eq: [𝑒-stream-class, '"java/util/stream/IntStream"']
    - eq: [𝑒-stream-class, '"java/util/stream/LongStream"']
    - eq: [𝑒-stream-class, '"java/util/stream/DoubleStream"']
