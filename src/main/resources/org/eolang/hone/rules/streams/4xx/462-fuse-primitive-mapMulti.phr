---
# yamllint disable rule:line-length
# The primitive sibling of `461-fuse-mapMulti` (#983). That rule pins
# `java/util/stream/Stream`, the object `BiConsumer` SAM and the
# `(Ljava/util/function/BiConsumer;)Ljava/util/stream/Stream;` signature in all
# three places it names a stream call, so a user-written
# `intStream.mapMulti(a).mapMulti(b)` stayed as two calls while the identical
# reference-form chain collapsed into one. Its own header said so: "Scope:
# reference Stream.mapMulti only".
#
# The composition is unchanged — `s.mapMulti((x, c) -> a(x, y -> b(y, c)))`:
#
#   fused(x, c):  invokestatic a$impl(x, W)   ; W = (IntConsumer) y -> b$impl(y, c)
#   wrap (c, y):  invokestatic b$impl(y, c)   ; the W body, capturing c
#
# What changes is every type around it. A primitive stage carries
# `IntStream.IntMapMultiConsumer` rather than `BiConsumer`, its SAM is
# `(ILjava/util/function/IntConsumer;)V` rather than
# `(Ljava/lang/Object;Ljava/lang/Object;)V`, and the sink it hands on is an
# `IntConsumer`. There is also no erasure to undo: the object rule builds W with
# `samMethodType` `(Ljava/lang/Object;)V` and an instantiated `(Lelem;)V`,
# whereas `IntConsumer.accept(int)` is `(I)V` on both, so the two types the
# metafactory gets here are the same one.
#
# All three primitive streams are handled by ONE rule rather than three copies,
# because only the types differ and every one of them follows from the SAM
# descriptor. The `or` below pins each quartet — the MapMultiConsumer interface,
# the SAM, the stream class and the stream signature — the way `203` pins the
# primitive filter arms, so a mismatched quartet can never be fused, and
# `𝑒-interface`, `𝑒-lambda-signature`, `𝑒-stream-class` and
# `𝑒-stream-signature` are shared between the two stages, which is also what
# keeps a chain on ONE primitive stream from fusing across a `mapToLong` in the
# middle of it.
#
# The item's LOCAL SLOT is the one thing that does not follow from a type
# rename: a long or a double occupies two slots, so the downstream sink sits at
# local 2 in `fused` for those and at local 1 for an int. `𝑒-consumer-slot`
# carries that (1 or 2), the item load follows the element (`iload`/`lload`/
# `dload`), and `wrap` needs no such care because its sink is parameter 0 and
# therefore always local 0. max-locals is 3 for every arm, which is an upper
# bound for all three.
#
# Both original bodies are kept untouched, exactly as in `461`: the rule wires
# the call graph and never inlines, so it is agnostic to how many values either
# body emits. The fused result is itself a primitive mapMulti Φ.hone.lambda, so
# a third adjacent stage folds into it on the next pass and a whole chain
# collapses left to right.
#
# It mints `fused_462`/`wrap_462`, not `fused_461`, and lives at 462 for that
# reason: two rules drawing from one `random-string` pattern get the same name
# in small-steps mode and produce two methods with one name in one class
# (#777). `RulesTest` enforces it.
name: fuse-primitive-mapMulti
pattern: |
  ⟦
    φ ↦ Φ.jeo.class,
    𝐵-class-head,
    𝜏-method ↦ ⟦
      φ ↦ Φ.jeo.method,
      𝐵-method-head,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-first ↦ ⟦
          φ ↦ Φ.hone.lambda,
          class ↦ 𝑒-class,
          method ↦ "accept",
          interface ↦ 𝑒-interface,
          lambda-signature ↦ 𝑒-lambda-signature,
          bridge-signature ↦ 𝑒-first-bridge,
          static ↦ "true",
          opcode ↦ "invokestatic",
          target ↦ ⟦
            handle ↦ 6,
            class ↦ 𝑒-first-class,
            method ↦ 𝑒-first-method,
            signature ↦ 𝑒-first-signature,
            is-interface ↦ 𝑒-first-is-interface
          ⟧,
          stream ↦ ⟦
            class ↦ 𝑒-stream-class,
            method ↦ "mapMulti",
            signature ↦ 𝑒-stream-signature
          ⟧
        ⟧,
        𝜏-second ↦ ⟦
          φ ↦ Φ.hone.lambda,
          class ↦ 𝑒-class,
          method ↦ "accept",
          interface ↦ 𝑒-interface,
          lambda-signature ↦ 𝑒-lambda-signature,
          bridge-signature ↦ 𝑒-second-bridge,
          static ↦ "true",
          opcode ↦ "invokestatic",
          target ↦ ⟦
            handle ↦ 6,
            class ↦ 𝑒-second-class,
            method ↦ 𝑒-second-method,
            signature ↦ 𝑒-second-signature,
            is-interface ↦ 𝑒-second-is-interface
          ⟧,
          stream ↦ ⟦
            class ↦ 𝑒-stream-class,
            method ↦ "mapMulti",
            signature ↦ 𝑒-stream-signature
          ⟧
        ⟧,
        𝐵-body-tail
      ⟧,
      𝐵-method-tail
    ⟧,
    𝐵-class-tail,
    ρ ↦ ∅
  ⟧
result: |
  ⟦
    φ ↦ Φ.jeo.class,
    𝐵-class-head,
    𝜏-method ↦ ⟦
      φ ↦ Φ.jeo.method,
      𝐵-method-head,
      body ↦ ⟦
        𝐵-body-head,
        𝜏-first ↦ ⟦
          φ ↦ Φ.hone.lambda,
          class ↦ 𝑒-class,
          method ↦ "accept",
          interface ↦ 𝑒-interface,
          lambda-signature ↦ 𝑒-lambda-signature,
          bridge-signature ↦ 𝑒-fused-signature,
          static ↦ "true",
          opcode ↦ "invokestatic",
          target ↦ ⟦
            handle ↦ 6,
            class ↦ 𝑒-class,
            method ↦ 𝑒-fused-name,
            signature ↦ 𝑒-fused-signature,
            is-interface ↦ 𝑒-first-is-interface
          ⟧,
          stream ↦ ⟦
            class ↦ 𝑒-stream-class,
            method ↦ "mapMulti",
            signature ↦ 𝑒-stream-signature
          ⟧
        ⟧,
        𝐵-body-tail
      ⟧,
      𝐵-method-tail
    ⟧,
    𝐵-class-tail,
    𝜏-fused-method ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 4106,
      descriptor ↦ 𝑒-fused-signature,
      signature ↦ "",
      maxs ↦ ⟦ φ ↦ Φ.jeo.maxs, max-stack ↦ 6, max-locals ↦ 3 ⟧,
      params ↦ ⟦
        φ ↦ Φ.jeo.params,
        i1 ↦ ⟦ φ ↦ Φ.jeo.param, index ↦ 0, access ↦ 0, type ↦ 𝑒-element ⟧,
        i2 ↦ ⟦ φ ↦ Φ.jeo.param, index ↦ 1, access ↦ 0, type ↦ 𝑒-consumer ⟧
      ⟧,
      body ↦ ⟦
        φ ↦ Φ.jeo.seq.of,
        ld-item ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-load-item, i1 ↦ 0 ⟧,
        ld-downstream ↦ ⟦ φ ↦ Φ.jeo.opcode.aload, i1 ↦ 𝑒-consumer-slot ⟧,
        mk-wrap ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokedynamic,
          i2 ↦ "accept",
          i3 ↦ 𝑒-wrap-factory,
          i4 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            i1 ↦ 6,
            i2 ↦ "java/lang/invoke/LambdaMetafactory",
            i3 ↦ "metafactory",
            i4 ↦ "(Ljava/lang/invoke/MethodHandles$Lookup;Ljava/lang/String;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodType;Ljava/lang/invoke/MethodHandle;Ljava/lang/invoke/MethodType;)Ljava/lang/invoke/CallSite;",
            i5 ↦ Φ.false
          ⟧,
          i5 ↦ ⟦ φ ↦ Φ.jeo.type, i1 ↦ 𝑒-wrap-instantiated ⟧,
          i6 ↦ ⟦
            φ ↦ Φ.jeo.handle,
            i1 ↦ 6,
            i2 ↦ 𝑒-class,
            i3 ↦ 𝑒-wrap-name,
            i4 ↦ 𝑒-wrap-signature,
            i5 ↦ 𝑒-first-is-interface
          ⟧,
          i7 ↦ ⟦ φ ↦ Φ.jeo.type, i1 ↦ 𝑒-wrap-instantiated ⟧
        ⟧,
        call-first ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokestatic,
          i2 ↦ 𝑒-first-class,
          i3 ↦ 𝑒-first-method,
          i4 ↦ 𝑒-first-signature,
          i5 ↦ 𝑒-first-is-interface
        ⟧,
        ret ↦ ⟦ φ ↦ Φ.jeo.opcode.return ⟧,
        ρ ↦ ∅
      ⟧,
      name ↦ 𝑒-fused-name
    ⟧,
    𝜏-wrap-method ↦ ⟦
      φ ↦ Φ.jeo.method,
      access ↦ 4106,
      descriptor ↦ 𝑒-wrap-signature,
      signature ↦ "",
      maxs ↦ ⟦ φ ↦ Φ.jeo.maxs, max-stack ↦ 6, max-locals ↦ 3 ⟧,
      params ↦ ⟦
        φ ↦ Φ.jeo.params,
        i1 ↦ ⟦ φ ↦ Φ.jeo.param, index ↦ 0, access ↦ 0, type ↦ 𝑒-consumer ⟧,
        i2 ↦ ⟦ φ ↦ Φ.jeo.param, index ↦ 1, access ↦ 0, type ↦ 𝑒-element ⟧
      ⟧,
      body ↦ ⟦
        φ ↦ Φ.jeo.seq.of,
        ld-item ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-load-item, i1 ↦ 1 ⟧,
        ld-downstream ↦ ⟦ φ ↦ Φ.jeo.opcode.aload, i1 ↦ 0 ⟧,
        call-second ↦ ⟦
          φ ↦ Φ.jeo.opcode.invokestatic,
          i2 ↦ 𝑒-second-class,
          i3 ↦ 𝑒-second-method,
          i4 ↦ 𝑒-second-signature,
          i5 ↦ 𝑒-second-is-interface
        ⟧,
        ret ↦ ⟦ φ ↦ Φ.jeo.opcode.return ⟧,
        ρ ↦ ∅
      ⟧,
      name ↦ 𝑒-wrap-name
    ⟧,
    ρ ↦ ∅
  ⟧
# Fire only on user-written mapMultis (javac names their bodies `lambda$…`), on
# any adapter a future flatMap-to-primitive-mapMulti rule synthesises
# (`flatadapt_…`), and on this rule's own products (`fused_…`), so a chain of
# three or more folds left-to-right. This exclusion is load bearing and became
# more so with #982: a pipeline-generated stage — the lowering 501/502 emit for
# a fused chain — targets a `distill_…` method, and since an IntStream chain can
# now lower to a primitive `IntStream.mapMulti` of its own, that output is a
# shape this rule would otherwise match. Re-fusing it through the adapter would
# only relocate an invokedynamic and break the pinned opcode counts of every
# fixture that measures one.
#
# The two target signatures must be the SAM descriptor itself. A non-capturing
# primitive stage always is (javac compiles the body to exactly
# `(ILjava/util/function/IntConsumer;)V`), and requiring it is what makes the
# composition below provably well typed: `fused` calls the first body with the
# item and W, and `wrap` calls the second with the item and the sink, so a
# target that took anything else would be a type error rather than a slower
# pipeline. Anything that is not of that shape stays as two calls, exactly as
# it is today.
when:
  and:
    - eq: [𝑒-first-class, 𝑒-class]
    - eq: [𝑒-second-class, 𝑒-class]
    - eq: [𝑒-first-bridge, 𝑒-lambda-signature]
    - eq: [𝑒-second-bridge, 𝑒-lambda-signature]
    - eq: [𝑒-first-signature, 𝑒-lambda-signature]
    - eq: [𝑒-second-signature, 𝑒-lambda-signature]
    - matches:
        - '(lambda\$|fused_|flatadapt_).+'
        - 𝑒-first-method
    - matches:
        - '(lambda\$|fused_|flatadapt_).+'
        - 𝑒-second-method
    - or:
        - and:
            - eq: [𝑒-interface, '"()Ljava/util/stream/IntStream$IntMapMultiConsumer;"']
            - eq: [𝑒-lambda-signature, '"(ILjava/util/function/IntConsumer;)V"']
            - eq: [𝑒-stream-class, '"java/util/stream/IntStream"']
            - eq: [𝑒-stream-signature, '"(Ljava/util/stream/IntStream$IntMapMultiConsumer;)Ljava/util/stream/IntStream;"']
        - and:
            - eq: [𝑒-interface, '"()Ljava/util/stream/LongStream$LongMapMultiConsumer;"']
            - eq: [𝑒-lambda-signature, '"(JLjava/util/function/LongConsumer;)V"']
            - eq: [𝑒-stream-class, '"java/util/stream/LongStream"']
            - eq: [𝑒-stream-signature, '"(Ljava/util/stream/LongStream$LongMapMultiConsumer;)Ljava/util/stream/LongStream;"']
        - and:
            - eq: [𝑒-interface, '"()Ljava/util/stream/DoubleStream$DoubleMapMultiConsumer;"']
            - eq: [𝑒-lambda-signature, '"(DLjava/util/function/DoubleConsumer;)V"']
            - eq: [𝑒-stream-class, '"java/util/stream/DoubleStream"']
            - eq: [𝑒-stream-signature, '"(Ljava/util/stream/DoubleStream$DoubleMapMultiConsumer;)Ljava/util/stream/DoubleStream;"']
where:
  - meta: 𝜏-fused-method
    function: random-tau
  - meta: 𝜏-wrap-method
    function: random-tau
  - meta: 𝑒-fused-name
    function: random-string
    args: [ '"fused_462%d"' ]
  - meta: 𝑒-wrap-name
    function: random-string
    args: [ '"wrap_462%d"' ]
  - meta: 𝑒-element
    function: sed
    # "(ILjava/util/function/IntConsumer;)V" -> "I"
    args:
      - 𝑒-lambda-signature
      - '"s/^[(](.)L.*/$1/"'
  - meta: 𝑒-consumer
    function: sed
    # "(ILjava/util/function/IntConsumer;)V" -> "Ljava/util/function/IntConsumer;"
    args:
      - 𝑒-lambda-signature
      - '"s/^[(].(L[^;]*;)[)]V$/$1/"'
  - meta: 𝑒-load-item
    function: sed
    args:
      - 𝑒-element
      - '"s/^I$/iload/"'
      - '"s/^J$/lload/"'
      - '"s/^D$/dload/"'
  - meta: 𝜏-load-item
    function: tau
    args: [𝑒-load-item]
  - meta: 𝑒-consumer-slot-str
    function: sed
    # the sink sits above the item, which takes two slots when it is wide
    args:
      - 𝑒-element
      - '"s/^I$/1/"'
      - '"s/^J$/2/"'
      - '"s/^D$/2/"'
  - meta: 𝑒-consumer-slot
    function: number
    args: [𝑒-consumer-slot-str]
  - meta: 𝑒-fused-signature
    function: concat
    args: [ '"("', 𝑒-element, 𝑒-consumer, '")V"' ]
  - meta: 𝑒-wrap-signature
    function: concat
    args: [ '"("', 𝑒-consumer, 𝑒-element, '")V"' ]
  - meta: 𝑒-wrap-instantiated
    function: concat
    args: [ '"("', 𝑒-element, '")V"' ]
  - meta: 𝑒-wrap-factory
    function: concat
    # "(Ljava/util/function/IntConsumer;)Ljava/util/function/IntConsumer;"
    args: [ '"("', 𝑒-consumer, '")"', 𝑒-consumer ]
