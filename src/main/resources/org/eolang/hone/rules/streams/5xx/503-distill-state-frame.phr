---
# yamllint disable rule:line-length
# Resolves the Φ.hone.frame-item marker that 307 / 308 leave at a
# stateful guard's keep-label. The operator is type-transparent — it
# returns the item it was given — so the stackmap frame there must
# declare the item's real type, which a type-agnostic fold cannot know.
# By the time the distill has been lowered to a Φ.hone.distill-lambda
# (502) the wrapper's shape is fixed, so this rule fills a FULL frame
# from it: locals are [captured List, item (bridge-input), Consumer,
# the int counter at slot 3] and the single stack item is the item. A
# full frame is required (not same-locals-1) because the counter 512
# adds at slot 3 outlives every branch — a same-locals frame would drop
# it and the next guard's `iload 3` would read an undefined local.
# Applied at fixpoint it fills the keep-label of every fused guard. It
# runs before 512 wraps the lambda into a method (503 < 512), so the
# marker never reaches jeo.
#
# (Stackmap recomputation is really the assembler's job; an opt-in
# COMPUTE_FRAMES on jeo:assemble would let every hone rule, this one and
# filter's 305 alike, drop hand-built frames. Tracked as a jeo follow-up.)
#
# This is the FALLBACK of the keep-frame family: it reads the stack item
# off `bridge-input`, which names the survivor only while every operator
# ahead of the guard in the fused body preserves the element type. When a
# type-CHANGING map is fused ahead, bridge-input is the head map's INPUT
# while the value at the keep-label is its OUTPUT, and the frame written
# here fails JVM verification (#798). The three rules that sort in front
# of this one — `503-distill-distinct-frame`,
# `503-distill-dropwhile-frame`, `503-distill-skip-frame` — claim those
# markers first and derive the stack item from the survivor, leaving this
# rule the guards with a type-preserving neighbour or nothing fused ahead
# of them at all, where bridge-input is right. The LOCAL at slot 1 is
# bridge-input in every case: it is the bridge method's declared
# parameter, whatever the body later does to the item.
name: distill-state-frame
pattern: |
  ⟦
    φ ↦ Φ.hone.distill-lambda,
    static ↦ 𝑒-static,
    bridge-input ↦ 𝑒-bridge-input,
    consumer ↦ 𝑒-consumer,
    target-method ↦ 𝑒-target-method,
    captured ↦ 𝑒-captured,
    body ↦ ⟦
      𝐵-before,
      𝜏-frame ↦ ⟦ φ ↦ Φ.hone.frame-item ⟧,
      𝐵-after,
      ρ ↦ ∅
    ⟧
  ⟧
result: |
  ⟦
    φ ↦ Φ.hone.distill-lambda,
    static ↦ 𝑒-static,
    bridge-input ↦ 𝑒-bridge-input,
    consumer ↦ 𝑒-consumer,
    target-method ↦ 𝑒-target-method,
    captured ↦ 𝑒-captured,
    body ↦ ⟦
      𝐵-before,
      𝜏-frame ↦ ⟦
        φ ↦ Φ.jeo.frame,
        type ↦ 0,
        locals ↦ ⟦
          φ ↦ Φ.jeo.seq.of4,
          x0 ↦ 𝑒-frame-captured,
          x1 ↦ 𝑒-frame-stack,
          x2 ↦ 𝑒-frame-consumer,
          x3 ↦ "integer"
        ⟧,
        stack ↦ ⟦
          φ ↦ Φ.jeo.seq.of1,
          x0 ↦ 𝑒-frame-stack
        ⟧
      ⟧,
      𝐵-after,
      ρ ↦ ∅
    ⟧
  ⟧
where:
  - meta: 𝑒-frame-stack
    function: sed
    args:
      - 𝑒-bridge-input
      - '"s/^B$/byte/g"'
      - '"s/^C$/char/g"'
      - '"s/^D$/double/g"'
      - '"s/^F$/float/g"'
      - '"s/^I$/integer/g"'
      - '"s/^J$/long/g"'
      - '"s/^S$/short/g"'
      - '"s/^Z$/boolean/g"'
      - '"s/^L(.+);$/$1/g"'
  - meta: 𝑒-frame-captured
    function: sed
    args:
      - 𝑒-captured
      - '"s/^L(.+);$/$1/g"'
  - meta: 𝑒-frame-consumer
    function: sed
    args:
      - 𝑒-consumer
      - '"s/^L(.+);$/$1/g"'
