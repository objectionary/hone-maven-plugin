---
# yamllint disable rule:line-length
# Resolves the Φ.hone.frame-item marker that 304 leaves at a stateless filter
# guard's keep-label, for the shape where the element the filter tested was
# MINTED right there by a fused map: the body reads invokestatic (the map) ->
# dup (the filter's guard copy) -> invokestatic (the predicate). The value the
# `dup` copied is the map's return value, so the survivor on the keep path has
# the map's return type and nothing else — not the distill's `bridge-input`,
# which names what the distill RECEIVED and stays whatever the method signature
# says.
#
# 509 (the fallback) would declare bridge-input here, which is right only while
# the element keeps its type across the fused run. A map that changes it —
# `map(Object::toString)` over a Stream<Long>, giving a distill with
# bridge-input ↦ Ljava/lang/Long; and an (Ljava/lang/String;)Z predicate —
# leaves the frame promising a Long where the stack holds a String, and the
# class dies at load time with "Inconsistent stackmap frames at branch target:
# Type 'java/lang/String' is not assignable to 'java/lang/Long'" (#794). 506
# already knows bridge-input is not always the survivor, but its guard claims
# only the PRIMITIVE-predicate shapes (#704, #713), so an object predicate fell
# through to the fallback.
#
# The `invokestatic` -> `dup` -> `invokestatic` adjacency is what makes deriving
# from the map safe: with the dup taken straight off the map's result, nothing
# can sit between them to widen or narrow it, and the one-slot `dup` says the
# result is a reference. A pipeline whose element is erased to Object and cast
# before the predicate keeps its `checkcast` between the two, so it does not
# match here and stays with 505/508. The predicate guard demands an object
# parameter for the same reason: a primitive predicate needs an unboxing call
# between the dup and the test, which breaks the adjacency anyway. Runs before
# 509 so the marker never reaches the fallback, and after 501, whose
# distill-lambda this pattern speaks. Scoped to a distill-lambda WITHOUT
# `captured`, so stateful keep-labels stay with 503/504.
name: distill-filter-frame-after-map
pattern: |
  ⟦
    φ ↦ Φ.hone.distill-lambda,
    static ↦ 𝑒-static,
    bridge-input ↦ 𝑒-bridge-input,
    returned ↦ 𝑒-returned,
    consumer ↦ 𝑒-consumer,
    target-method ↦ 𝑒-target-method,
    body ↦ ⟦
      𝐵-before,
      𝜏-map ↦ ⟦
        φ ↦ Φ.jeo.opcode.invokestatic,
        i2 ↦ 𝑒-map-class,
        i3 ↦ 𝑒-map-method,
        i4 ↦ 𝑒-map-signature,
        i5 ↦ 𝑒-map-is-interface
      ⟧,
      𝜏-dup ↦ ⟦ φ ↦ Φ.jeo.opcode.dup ⟧,
      𝜏-predicate ↦ ⟦
        φ ↦ Φ.jeo.opcode.invokestatic,
        i2 ↦ 𝑒-predicate-class,
        i3 ↦ 𝑒-predicate-method,
        i4 ↦ 𝑒-predicate-signature,
        i5 ↦ 𝑒-predicate-is-interface
      ⟧,
      𝜏-ifne ↦ ⟦ φ ↦ Φ.jeo.opcode.ifne, i2 ↦ 𝑒-ifne-target ⟧,
      𝜏-return ↦ ⟦ φ ↦ Φ.jeo.opcode.return ⟧,
      𝜏-keep-label ↦ ⟦ φ ↦ Φ.jeo.label, i1 ↦ 𝑒-keep-label ⟧,
      𝜏-frame ↦ ⟦ φ ↦ Φ.hone.frame-item ⟧,
      𝐵-after,
      ρ ↦ ∅
    ⟧
  ⟧
result: |
  ⟦
    φ ↦ Φ.hone.distill-lambda,
    static ↦ 𝑒-static,
    bridge-input ↦ 𝑒-bridge-input,
    returned ↦ 𝑒-returned,
    consumer ↦ 𝑒-consumer,
    target-method ↦ 𝑒-target-method,
    body ↦ ⟦
      𝐵-before,
      𝜏-map ↦ ⟦
        φ ↦ Φ.jeo.opcode.invokestatic,
        i2 ↦ 𝑒-map-class,
        i3 ↦ 𝑒-map-method,
        i4 ↦ 𝑒-map-signature,
        i5 ↦ 𝑒-map-is-interface
      ⟧,
      𝜏-dup ↦ ⟦ φ ↦ Φ.jeo.opcode.dup ⟧,
      𝜏-predicate ↦ ⟦
        φ ↦ Φ.jeo.opcode.invokestatic,
        i2 ↦ 𝑒-predicate-class,
        i3 ↦ 𝑒-predicate-method,
        i4 ↦ 𝑒-predicate-signature,
        i5 ↦ 𝑒-predicate-is-interface
      ⟧,
      𝜏-ifne ↦ ⟦ φ ↦ Φ.jeo.opcode.ifne, i2 ↦ 𝑒-ifne-target ⟧,
      𝜏-return ↦ ⟦ φ ↦ Φ.jeo.opcode.return ⟧,
      𝜏-keep-label ↦ ⟦ φ ↦ Φ.jeo.label, i1 ↦ 𝑒-keep-label ⟧,
      𝜏-frame ↦ ⟦
        φ ↦ Φ.jeo.frame,
        type ↦ 4,
        nlocal ↦ 0,
        locals ↦ ⟦ φ ↦ Φ.jeo.seq.of0 ⟧,
        nstack ↦ 1,
        stack ↦ ⟦ φ ↦ Φ.jeo.seq.of1, item ↦ 𝑒-frame-item ⟧
      ⟧,
      𝐵-after,
      ρ ↦ ∅
    ⟧
  ⟧
when:
  and:
    - matches:
        - '^\(.*\)L.+;$'
        - 𝑒-map-signature
    - matches:
        - '^\(L.+;\)Z$'
        - 𝑒-predicate-signature
where:
  - meta: 𝑒-frame-item
    function: sed
    args:
      - 𝑒-map-signature
      - '"s/^\\(.*\\)L(.+);$/$1/g"'
