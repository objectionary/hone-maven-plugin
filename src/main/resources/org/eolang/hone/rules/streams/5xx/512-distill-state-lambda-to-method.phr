---
# yamllint disable rule:line-length
# State-carrying sibling of 511. Builds the private static wrapper for a
# distill that captured state, distinguished from 511's stateless
# distill-lambda by the extra `captured` binding. The captured List (one
# per wrapper, holding every fused operator's state object in body order)
# is argument 0, the item is argument 1, the downstream Consumer is
# argument 2, so the leading item-load is `aload 1` and the trailing
# consumer-load is `aload 2` (511's are 0 and 1). The body opens by
# zeroing a per-call counter just above the arguments (`iconst_0; istore`);
# 521 turns
# each fetch marker into List.get(counter); iinc so the N fetches walk the
# List in body order — guard k reads state var k. max-locals is 7 (not 4):
# slots 0-4 are the args plus the counter above, and 310's dropWhile latch
# guard borrows slots 5-6 as scratch (the latch array and the negated
# predicate result), dead by its keep-label so 503's four-local frame still
# holds. The extra slots are unused by stateless distinct/skip guards and
# cost nothing there.
#
# The INPUT item is no longer always a reference. It was while the only
# stateful operators were object-stream ones (distinct and skip pin
# java/util/stream/Stream; the object dropWhile does too), but 208's primitive
# sibling (#982) lifts an IntStream.dropWhile, 411 collapses the box/unbox pair
# around the distill it folds into, and the item then arrives as a raw int. So
# the leading load follows `bridge-input` rather than being a fixed aload 1 —
# `iload` for I, `aload` for a reference — and the frame rules name local 1
# "integer" for the same reason.
#
# A WIDE item is reachable too, since #1012. A long or a double occupies TWO
# local slots, so the layout is not fixed: the consumer moves from 2 to 3 and
# the counter from 3 to 4. Both are derived below from `bridge-input`, which is
# the wrapper's own declared item type and therefore the single place the width
# is read from; `521` reads the same width off the parameter this rule declares,
# because a bare fetch marker cannot tell it.
#
# The latch scratch 310 borrows does NOT shift. It sits at a fixed 5 and 6, one
# slot above the widest possible counter, and max-locals is a fixed 7. That is
# what keeps the widening to two derived numbers instead of five: the latch is
# dead by its keep-label, so no frame ever lists it, and a slot no frame lists
# may be left unwritten — for a narrow item slot 4 simply goes unused. Every
# frame in the family stays a FOUR-local frame either way, because a stackmap
# frame lists one entry per VALUE and not per slot: (List, item, consumer,
# counter) is four entries whether the item is one slot wide or two.
#
# The OUTPUT may differ from the input: when 451 fuses a trailing mapToX into
# this stateful distill the body ends on a primitive, so the closing dup /
# Consumer.accept follow the consumer type (Int/Long/DoubleConsumer), exactly
# as 511 does for a stateless type-transition distill.
name: distill-state-lambda-to-method
pattern: |
  ⟦
    φ ↦ Φ.hone.distill-lambda,
    static ↦ "true",
    bridge-input ↦ 𝑒-bridge-input,
    consumer ↦ 𝑒-consumer,
    target-method ↦ 𝑒-target-method,
    captured ↦ 𝑒-captured,
    body ↦ ⟦ 𝐵-body, ρ ↦ ∅ ⟧
  ⟧
result: |
  ⟦
    φ ↦ Φ.jeo.method,
    access ↦ 4106,
    descriptor ↦ 𝑒-descriptor,
    signature ↦ "",
    maxs ↦ ⟦
      φ ↦ Φ.jeo.maxs,
      max-stack ↦ 10,
      max-locals ↦ 7
    ⟧,
    params ↦ ⟦
      φ ↦ Φ.jeo.params,
      i1 ↦ ⟦ φ ↦ Φ.jeo.param, index ↦ 0, access ↦ 0, type ↦ 𝑒-captured ⟧,
      i2 ↦ ⟦ φ ↦ Φ.jeo.param, index ↦ 1, access ↦ 0, type ↦ 𝑒-bridge-input ⟧,
      i3 ↦ ⟦ φ ↦ Φ.jeo.param, index ↦ 2, access ↦ 0, type ↦ 𝑒-consumer ⟧
    ⟧,
    body ↦ ⟦
      φ ↦ Φ.jeo.seq.of,
      i-init-counter ↦ ⟦ φ ↦ Φ.jeo.opcode.iconst_0 ⟧,
      i-store-counter ↦ ⟦ φ ↦ Φ.jeo.opcode.istore, i1 ↦ 𝑒-counter-slot ⟧,
      i-load-item ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-load-item, i1 ↦ 1 ⟧,
      𝐵-body,
      i-load-consumer ↦ ⟦ φ ↦ Φ.jeo.opcode.aload, i1 ↦ 𝑒-consumer-slot ⟧,
      i-dup-x ↦ ⟦ φ ↦ Φ.jeo.opcode.𝜏-dup-x ⟧,
      i-pop ↦ ⟦ φ ↦ Φ.jeo.opcode.pop ⟧,
      i-invoke ↦ ⟦
        φ ↦ Φ.jeo.opcode.invokeinterface,
        i2 ↦ 𝑒-consumer-class,
        i3 ↦ "accept",
        i4 ↦ 𝑒-invokeinterface-signature,
        i5 ↦ Φ.true
      ⟧,
      i-return ↦ ⟦ φ ↦ Φ.jeo.opcode.return ⟧,
      ρ ↦ ∅
    ⟧,
    name ↦ 𝑒-target-method
  ⟧
where:
  - meta: 𝑒-descriptor
    function: concat
    args:
      - '"("'
      - 𝑒-captured
      - 𝑒-bridge-input
      - 𝑒-consumer
      - '")V"'
  # The leading load follows the INPUT item: a raw int since 411 may now hand
  # this wrapper a primitive item (#982), a reference otherwise.
  - meta: 𝑒-load-item
    function: sed
    args:
      - 𝑒-bridge-input
      - '"s/^I$/iload/g"'
      - '"s/^J$/lload/g"'
      - '"s/^D$/dload/g"'
      - '"s/^L.+;$/aload/g"'
  - meta: 𝜏-load-item
    function: tau
    args: [𝑒-load-item]
  # The two slot numbers the item's WIDTH moves (#1012). A long or a double
  # takes two slots, so everything above the item slides by one. Read off
  # `bridge-input` here and off the parameter this rule declares in 521.
  - meta: 𝑒-consumer-slot-str
    function: sed
    args:
      - 𝑒-bridge-input
      - '"s/^J$/3/g"'
      - '"s/^D$/3/g"'
      - '"s/^I$/2/g"'
      - '"s/^L.+;$/2/g"'
  - meta: 𝑒-consumer-slot
    function: number
    args: [𝑒-consumer-slot-str]
  - meta: 𝑒-counter-slot-str
    function: sed
    args:
      - 𝑒-bridge-input
      - '"s/^J$/4/g"'
      - '"s/^D$/4/g"'
      - '"s/^I$/3/g"'
      - '"s/^L.+;$/3/g"'
  - meta: 𝑒-counter-slot
    function: number
    args: [𝑒-counter-slot-str]
  - meta: 𝑒-consumer-class
    function: sed
    args:
      - 𝑒-consumer
      - '"s/L(.+);/$1/g"'
  # The value the body leaves on the stack before the emit is the OUTPUT type,
  # so (exactly as 511) the stack-arrangement dup and the consumer.accept
  # argument follow the consumer: an Int/Long/DoubleConsumer for a stateful
  # type-transition distill (object in, primitive out, produced when 451 fuses
  # a trailing mapToX into a stateful distill), or the object Consumer for a
  # symmetric distinct/skip. The item is always an object (v1 stateful limit),
  # so only the leading load has to follow the input.
  - meta: 𝑒-dup-x
    function: sed
    args:
      - 𝑒-consumer
      - '"s/^Ljava\\/util\\/function\\/DoubleConsumer;$/dup_x2/g"'
      - '"s/^Ljava\\/util\\/function\\/LongConsumer;$/dup_x2/g"'
      - '"s/^Ljava\\/util\\/function\\/IntConsumer;$/dup_x1/g"'
      - '"s/^Ljava\\/util\\/function\\/Consumer;$/dup_x1/g"'
  - meta: 𝜏-dup-x
    function: tau
    args: [𝑒-dup-x]
  - meta: 𝑒-invokeinterface-input
    function: sed
    args:
      - 𝑒-consumer
      - '"s/^Ljava\\/util\\/function\\/Consumer;$/Ljava\\/lang\\/Object;/g"'
      - '"s/^Ljava\\/util\\/function\\/IntConsumer;$/I/g"'
      - '"s/^Ljava\\/util\\/function\\/LongConsumer;$/J/g"'
      - '"s/^Ljava\\/util\\/function\\/DoubleConsumer;$/D/g"'
  - meta: 𝑒-invokeinterface-signature
    function: concat
    args: ['"("', 𝑒-invokeinterface-input, '")V"']
