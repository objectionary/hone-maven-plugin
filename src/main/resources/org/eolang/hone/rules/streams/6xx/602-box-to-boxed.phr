---
# yamllint disable rule:line-length
# The box pattern binds `minted` to an expression rather than pinning it, so
# this rule takes a box whoever minted it — which is what it did before every
# box carried the binding (#1016).
name: box-to-boxed
pattern: |
  ⟦
    φ ↦ Φ.hone.box,
    stream-class ↦ 𝑒-stream-class,
    minted ↦ 𝑒-box-minted
  ⟧
result: |
  ⟦
    φ ↦ Φ.jeo.opcode.invokeinterface,
    i1 ↦ 𝑒-stream-class,
    i2 ↦ "boxed",
    i3 ↦ "()Ljava/util/stream/Stream;",
    i4 ↦ Φ.true
  ⟧
